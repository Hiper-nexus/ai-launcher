    local tok; tok=$(hf_require_token) || return 1
    require_python || return 1
    echo -e "${BOLD}HF Endpoint${RESET}"
    echo -e "  modelo: ${HF_ENDPOINT_MODEL}"
    echo -e "  url:    $(hf_endpoint_url)"
    local user
    user=$(HF_TOK="$tok" python3 - <<'PY' 2>/dev/null
import json,os,urllib.request
req=urllib.request.Request("https://huggingface.co/api/whoami-v2",
    headers={"Authorization":"Bearer "+os.environ["HF_TOK"]})
print(json.load(urllib.request.urlopen(req,timeout=30)).get("name",""))
PY
)
    [[ -z "$user" ]] && return 0
    HF_TOK="$tok" HF_USER="$user" python3 - <<'PY' 2>/dev/null
import json,os,urllib.request,urllib.error
tok=os.environ["HF_TOK"]; user=os.environ["HF_USER"]
try:
    req=urllib.request.Request(
        f"https://api.endpoints.huggingface.cloud/v2/endpoint/{user}",
        headers={"Authorization":"Bearer "+tok})
    d=json.load(urllib.request.urlopen(req,timeout=30))
except Exception:
    raise SystemExit
for e in d.get("items",[]):
