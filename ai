# URL do endpoint: env → providers.conf (slot dedicado) → vazio.
# Mantida fora do script porque o repo é público.
hf_endpoint_url() {
    local u="${HF_ENDPOINT_URL:-}"
    if [[ -z "$u" ]]; then
        u=$(provider_load_key hf-endpoint-url 2>/dev/null || true)
    fi
    printf '%s' "$u"
}

hf_save_endpoint_url() {
    local url="${1:-}"
    if [[ -z "$url" && -t 0 ]]; then
        read -rp "$(echo -e "  ${BOLD}URL do HF Endpoint:${RESET} ")" url
    fi
    # Remove espaços/CR de colagem e barra final
    url="${url//$'\r'/}"; url="${url//[[:space:]]/}"; url="${url%/}"
    [[ -z "$url" ]] && { echo -e "${RED}Erro: URL vazia.${RESET}" >&2; return 1; }
    if [[ ! "$url" =~ ^https:// ]]; then
        echo -e "${RED}Erro: a URL precisa começar com https://${RESET}" >&2
        return 1
    fi
    provider_save_key hf-endpoint-url "$url" || return 1
    echo -e "${GREEN}✔ Endpoint salvo em ${PROVIDERS_FILE}${RESET} ${DIM}(chmod 600)${RESET}"
}

# Token: env vars primeiro, depois o cofre do launcher, por fim o do HF CLI
hf_token() {
    local t="${HF_TOKEN:-${HUGGING_FACE_HUB_TOKEN:-${HUGGINGFACE_TOKEN:-}}}"
    if [[ -z "$t" ]]; then
        t=$(provider_load_key hf 2>/dev/null || true)
    fi
    if [[ -z "$t" && -r "$HOME/.cache/huggingface/token" ]]; then
        t=$(tr -d '\r\n' < "$HOME/.cache/huggingface/token" 2>/dev/null || true)
    fi
    printf '%s' "$t"
}

hf_require_token() {
    local t; t=$(hf_token)
    if [[ -z "$t" ]]; then
        echo -e "${RED}Erro: nenhum token da Hugging Face encontrado.${RESET}" >&2
        echo "  Crie um em: https://huggingface.co/settings/tokens" >&2
        echo "  Depois:     ai hf key" >&2
        return 1
    fi
    printf '%s' "$t"
}

hf_save_key() {
    local key="${1:-}"
    if [[ -z "$key" && -t 0 ]]; then
        read -rsp "$(echo -e "  ${BOLD}Token da Hugging Face:${RESET} ")" key
        echo ""
    fi
    [[ -z "$key" ]] && { echo -e "${RED}Erro: token vazio.${RESET}" >&2; return 1; }
    provider_save_key hf "$key" || return 1
    echo -e "${GREEN}✔ Token salvo em ${PROVIDERS_FILE}${RESET} ${DIM}(chmod 600)${RESET}"
}

hf_status_icon() {
    if [[ -z "$(hf_token)" ]]; then
        echo -e "${YELLOW}✗ sem token${RESET}"
    elif [[ -z "$(hf_endpoint_url)" ]]; then
        echo -e "${YELLOW}✗ sem endpoint${RESET}"
    else
        echo -e "${GREEN}✔${RESET}"
    fi
}

# Chat contra o Inference Endpoint (API OpenAI via vLLM).
# Sem prompt = REPL; com prompt = one-shot. Lida com cold start do scale-to-zero.
hf_endpoint_chat() {
    local tok; tok=$(hf_require_token) || return 1
    require_python || return 1
    local url; url=$(hf_endpoint_url)
    if [[ -z "$url" ]]; then
        echo -e "${RED}Erro: nenhum HF Endpoint configurado.${RESET}" >&2
        echo "  Configure: ai hf endpoint <url>" >&2
        echo "  Ou:        export AI_HF_ENDPOINT_URL=<url>" >&2
        return 1
    fi

    save_history "HF Endpoint [${HF_ENDPOINT_MODEL##*/}]"

    if [[ $# -gt 0 ]]; then
        echo -e "${GREEN}HF Endpoint:${RESET} ${HF_ENDPOINT_MODEL##*/} ${DIM}(one-shot)${RESET}"
    else
        echo -e "${GREEN}HF Endpoint:${RESET} ${HF_ENDPOINT_MODEL##*/} ${DIM}(/sair encerra, /limpar zera o contexto)${RESET}"
    fi
    echo -e "${DIM}scale-to-zero: a 1ª chamada pode levar ~1-2 min pra acordar a GPU${RESET}"
    echo ""

    local pyfile
    pyfile=$(mktemp -t ai-hf.XXXXXX) || return 1
    trap "rm -f '$pyfile'" RETURN
    cat > "$pyfile" <<'PY'
import json, os, re, sys, urllib.request, urllib.error, time

URL = os.environ["HF_URL"].rstrip("/") + "/v1/chat/completions"
TOK = os.environ["HF_TOK"]
MODEL = os.environ["HF_MODEL"]
DIM, RESET, RED = "\033[2m", "\033[0m", "\033[31m"

# Modelos "thinking" servidos por vLLM fundem o raciocínio no content, muitas
# vezes fechando com </think> (a tag de abertura vem implícita no template).
# Guardamos no histórico só a resposta final: reenviar o raciocínio a cada
# turno estoura o contexto e piora o modelo.
def strip_thinking(text):
    return re.sub(r"(?s)^\s*(?:<think>)?.*?</think>\s*", "", text, count=1)

# Thinking DESLIGADO por padrão (respostas diretas); AI_HF_THINKING=1 religa.
THINK = os.environ.get("HF_THINK", "0") == "1"

def stream(messages):
    payload = {"model": MODEL, "messages": messages, "stream": True,
               "max_tokens": 4096}
    if not THINK:
        payload["chat_template_kwargs"] = {"enable_thinking": False}
    body = json.dumps(payload).encode()
    req = urllib.request.Request(
        URL, data=body,
        headers={"Authorization": "Bearer " + TOK, "Content-Type": "application/json"},
    )
    # Cold start: a GPU pode estar dormindo (503/502). Tenta reconectar ~2 min.
    deadline = None
    while True:
        try:
            r = urllib.request.urlopen(req, timeout=600)
            break
        except urllib.error.HTTPError as e:
            if e.code in (502, 503) :
                if deadline is None:
                    deadline = 120
                    sys.stdout.write(DIM + "acordando a GPU" + RESET)
                    sys.stdout.flush()
                if deadline <= 0:
                    print(f"\n{RED}erro: endpoint não acordou a tempo{RESET}", file=sys.stderr)
                    return None
                sys.stdout.write("."); sys.stdout.flush()
                time.sleep(6); deadline -= 6; continue
            print(f"{RED}erro HTTP {e.code}: {e.read().decode('utf-8','replace')[:300]}{RESET}", file=sys.stderr)
            return None
        except Exception as e:
            print(f"{RED}erro: {e}{RESET}", file=sys.stderr)
            return None
    if deadline is not None:
        sys.stdout.write("\n")
    parts = []
    try:
        for raw in r:
            raw = raw.strip()
            if not raw or not raw.startswith(b"data:"):
                continue
            payload = raw[5:].strip()
            if payload == b"[DONE]":
                break
            try:
                chunk = json.loads(payload)
            except json.JSONDecodeError:
                continue
            delta = (chunk.get("choices") or [{}])[0].get("delta") or {}
            c = delta.get("content")
            if c:
                sys.stdout.write(c); sys.stdout.flush(); parts.append(c)
    except KeyboardInterrupt:
        print(); return "".join(parts)
    print()
    return "".join(parts)

if len(sys.argv) > 1:
    out = stream([{"role": "user", "content": " ".join(sys.argv[1:])}])
    sys.exit(0 if out is not None else 1)

history = []
while True:
    try:
        line = input("\033[1m› \033[0m").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nSaindo."); break
    if not line:
        continue
    if line in ("/sair", "/exit", "/quit", "/q"):
        print("Saindo."); break
    if line in ("/limpar", "/clear", "/reset"):
        history = []; print(f"{DIM}contexto zerado{RESET}"); continue
    history.append({"role": "user", "content": line})
    out = stream(history)
    if out is None:
        history.pop(); continue
    history.append({"role": "assistant", "content": strip_thinking(out)})
    print()
PY

    HF_URL="$url" HF_TOK="$tok" HF_MODEL="$HF_ENDPOINT_MODEL" \
        HF_THINK="${AI_HF_THINKING:-0}" python3 "$pyfile" "$@"
}

# Estado do endpoint via API de gerenciamento da HF
