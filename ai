            provider="sakana"
            ;;
        ""|codex|openai)
            return 0
            ;;
        *)
            echo -e "${RED}Provider ${provider} não está configurado para Codex no launcher.${RESET}"
            echo "  Para Sakana/Fugu use: ai x --via sakana"
            return 1
            ;;
    esac

    sakana_install_codex_config quiet

    local api_key
    api_key=$(provider_load_key "$provider") || true
    api_key="${api_key:-${SAKANA_API_KEY:-}}"

    if [[ -z "$api_key" ]]; then
        if [[ -t 0 ]]; then
            read -rsp "$(echo -e "  ${BOLD}API Key para sakana:${RESET} ")" api_key
            echo ""
            if [[ -n "$api_key" ]]; then
                provider_save_key "$provider" "$api_key"
                echo -e "${GREEN}✔ Key salva em ${PROVIDERS_FILE}${RESET}"
            fi
        else
            echo -e "${RED}Erro: API key para sakana não configurada.${RESET}"
            echo "  Configure: ai p add sakana"
            return 1
        fi
    fi

    export SAKANA_API_KEY="$api_key"
    echo -e "${CYAN}Provider:${RESET} sakana → https://api.sakana.ai/v1"
}

