# ── Funções utilitárias ──────────────────────────────────

get_version() {
    local cmd="$1"
    if command -v "$cmd" &>/dev/null; then
        "$cmd" --version 2>/dev/null | head -1 || echo "?"
    else
        echo "-"
    fi
}

check_installed() {
    command -v "$1" &>/dev/null
}

status_icon() {
    local cmd="$1"
    if ! check_installed "$cmd"; then
        echo -e "${RED}✗ não instalado${RESET}"
    else
        echo -e "${GREEN}✔${RESET}"
    fi
}

provider_cli_status_icon() {
    local provider="$1" cmd="$2"
    if ! check_installed "$cmd"; then
        echo -e "${RED}✗ ${cmd} não instalado${RESET}"
    elif [[ -n "$(provider_load_key "$provider")" ]]; then
        echo -e "${GREEN}✔${RESET}"
    elif [[ "$provider" == "sakana" && -n "${SAKANA_API_KEY:-}" ]]; then
        echo -e "${GREEN}✔${RESET}"
    else
