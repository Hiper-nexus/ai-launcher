# Chat contra o Featherless (API OpenAI + User-Agent p/ passar o Cloudflare).
# Sem prompt = REPL; com prompt = one-shot. Trata "capacity_exhausted" (retry).
fl_chat() {
    local model="$1"; shift
    local key; key=$(fl_require_key) || return 1
    require_python || return 1

    save_history "Featherless [${model##*/}]"
    if [[ $# -gt 0 ]]; then
