    fi
}

save_history() {
    echo "$(date '+%Y-%m-%d %H:%M') | $1" >> "$HISTORY_FILE"
}

show_last_used() {
    if [[ -f "$HISTORY_FILE" ]]; then
        local last
        last=$(tail -1 "$HISTORY_FILE")
        echo -e "  ${DIM}Último uso: ${last}${RESET}"
    fi
}

normalize_choice() {
    printf '%s' "${1:-}" | tr -d '[:space:]'
}

launch() {
    local name="$1" cmd="$2" prompt_flag="$3"
    local flags_name="$4"
    shift 4

    local flags_ref=()
    case "$flags_name" in
        CLAUDE_FLAGS) flags_ref=("${CLAUDE_FLAGS[@]}") ;;
        CODEX_FLAGS)  flags_ref=("${CODEX_FLAGS[@]}") ;;
        GEMINI_FLAGS) flags_ref=("${GEMINI_FLAGS[@]}") ;;
        AGY_FLAGS)    flags_ref=("${AGY_FLAGS[@]+"${AGY_FLAGS[@]}"}") ;;
        KIMI_FLAGS)   flags_ref=("${KIMI_FLAGS[@]+"${KIMI_FLAGS[@]}"}") ;;
        GROK_FLAGS)   flags_ref=("${GROK_FLAGS[@]+"${GROK_FLAGS[@]}"}") ;;
        QODER_FLAGS)  flags_ref=("${QODER_FLAGS[@]+"${QODER_FLAGS[@]}"}") ;;
        CURSOR_FLAGS) flags_ref=("${CURSOR_FLAGS[@]+"${CURSOR_FLAGS[@]}"}") ;;
        *)
            echo -e "${RED}Erro interno: array de flags desconhecida (${flags_name}).${RESET}"
            exit 1
            ;;
    esac

    if ! check_installed "$cmd"; then
        echo -e "${RED}Erro: ${cmd} não está instalado.${RESET}"
        case "$cmd" in
            claude) echo "  Instale: npm install -g @anthropic-ai/claude-code" ;;
            codex)  echo "  Instale: npm install -g @openai/codex" ;;
            gemini) echo "  Instale: sudo npm install -g @google/gemini-cli" ;;
            agy)    echo "  Instale: curl -fsSL https://antigravity.google/cli/install.sh | bash" ;;
            kimi)   echo "  Instale: curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash" ;;
            grok)   echo "  Instale: curl -fsSL https://x.ai/cli/install.sh | bash" ;;
            qodercli) echo "  Instale: npm install -g @qoder-ai/qodercli" ;;
            cursor-agent)
                echo "  Instale: curl https://cursor.com/install -fsS | bash"
                echo -e "  ${YELLOW}Aviso:${RESET} o instalador sobrescreve ~/.local/bin/agent"
                echo "  (que aqui aponta para o Grok). O launcher usa o symlink"
                echo "  cursor-agent, então basta restaurar 'agent' depois:"
                echo "    ln -sf ~/.grok/bin/agent ~/.local/bin/agent"
                ;;
        esac
        exit 1
    fi

    save_history "$name${_active_provider:+ [${_active_provider}]}"

    # Cópia local para não mutar o array do caller
    local -a final_flags=("${flags_ref[@]+"${flags_ref[@]}"}")

    if [[ $# -gt 0 ]]; then
        local prompt="$*"
        if [[ -n "$prompt_flag" ]]; then
            echo -e "${GREEN}Iniciando ${name}:${RESET} ${cmd} ${final_flags[*]+"${final_flags[*]}"} ${prompt_flag} \"${prompt}\""
        else
            echo -e "${GREEN}Iniciando ${name}:${RESET} ${cmd} ${final_flags[*]+"${final_flags[*]}"} -- \"${prompt}\""
        fi
        echo ""
        if [[ -n "$prompt_flag" ]]; then
            exec "$cmd" ${final_flags[@]+"${final_flags[@]}"} "$prompt_flag" "$prompt"
        else
            exec "$cmd" ${final_flags[@]+"${final_flags[@]}"} -- "$prompt"
        fi
    else
        echo -e "${GREEN}Iniciando ${name}:${RESET} ${cmd} ${final_flags[*]+"${final_flags[*]}"}"

        echo ""
        exec "$cmd" ${final_flags[@]+"${final_flags[@]}"}
    fi
}

# ╔══════════════════════════════════════════════════════╗
# ║  OLLAMA — cloud (API key) e local (binário)          ║
# ╚══════════════════════════════════════════════════════╝

# Key: env var tem prioridade, senão lê o providers.conf (chmod 600).
# Slot dedicado 'ollama-cloud' para não colidir com o provider 'ollama'
# (que o Claude Code usa contra um ollama LOCAL). Lê o slot legado 'ollama'
# como fallback para não quebrar quem salvou antes desta separação.
ollama_api_key() {
    local k="${OLLAMA_API_KEY:-}"
    if [[ -z "$k" ]]; then
        k=$(provider_load_key ollama-cloud 2>/dev/null || true)
    fi
    if [[ -z "$k" ]]; then
        k=$(provider_load_key ollama 2>/dev/null || true)
    fi
    printf '%s' "$k"
}

ollama_require_key() {
    local k
    k=$(ollama_api_key)
    if [[ -z "$k" ]]; then
        echo -e "${RED}Erro: nenhuma API key da Ollama configurada.${RESET}" >&2
        echo "  Crie uma em: https://ollama.com/settings/keys" >&2
        echo "  Depois rode: ai ol key" >&2
        return 1
    fi
    printf '%s' "$k"
}

# python3 é usado pelos clientes cloud (Ollama Cloud e HF Endpoint)
require_python() {
    if ! command -v python3 &>/dev/null; then
        echo -e "${RED}Erro: python3 é necessário para este comando.${RESET}" >&2
        return 1
    fi
}

# Salva a key no providers.conf (mesmo cofre dos demais providers)
ollama_save_key() {
    local key="${1:-}"
    if [[ -z "$key" && -t 0 ]]; then
        read -rsp "$(echo -e "  ${BOLD}API key da Ollama:${RESET} ")" key
        echo ""
    fi
    if [[ -z "$key" ]]; then
        echo -e "${RED}Erro: key vazia.${RESET}" >&2
        return 1
    fi
    provider_save_key ollama-cloud "$key" || return 1
    echo -e "${GREEN}✔ Key salva em ${PROVIDERS_FILE}${RESET} ${DIM}(chmod 600)${RESET}"
}

# Lista os modelos que a Ollama realmente serve no cloud
ollama_cloud_list() {
    local key; key=$(ollama_require_key) || return 1
    require_python || return 1
    echo -e "${BOLD}Modelos disponíveis no Ollama Cloud:${RESET}"
    OLLAMA_KEY="$key" OLLAMA_HOSTV="$OLLAMA_CLOUD_HOST" python3 - <<'PY'
