sakana_remove_provider_config() {
    local config="$1"
    local tmp_config
    tmp_config=$(mktemp) || return 1
    trap "rm -f '$tmp_config'" RETURN
    awk '
        /^# ai-launcher: Sakana Fugu provider$/ { pending_comment = $0; next }
        /^\[model_providers\.sakana\]$/ { pending_comment = ""; skip = 1; next }
        /^\[/ && skip { skip = 0 }
        {
            if (pending_comment != "") {
                print pending_comment
                pending_comment = ""
            }
            if (!skip) print
        }
        END {
            if (pending_comment != "") print pending_comment
        }
    ' "$config" > "$tmp_config"
    mv "$tmp_config" "$config"
    chmod 600 "$config"
    trap - RETURN
}

sakana_write_codex_wrapper() {
    local wrapper="$1"
    cat > "$wrapper" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

providers_file="${HOME}/.local/share/ai-launcher/providers.conf"
if [[ -z "${SAKANA_API_KEY:-}" && -f "$providers_file" ]]; then
    key=$(grep -F "sakana=" "$providers_file" 2>/dev/null | grep "^sakana=" | tail -1 | cut -d= -f2- || true)
    if [[ -n "$key" ]]; then
        export SAKANA_API_KEY="$key"
    fi
fi

if [[ -z "${SAKANA_API_KEY:-}" ]]; then
    echo "Erro: SAKANA_API_KEY nao configurada."
    echo "  Configure: ai p add sakana"
    exit 1
fi

exec codex -p fugu "$@"
SH
    chmod 755 "$wrapper"
}


sakana_install_codex_config() {
    local mode="${1:-}"
    local quiet=false
    local force=false
    case "$mode" in
        quiet) quiet=true ;;
        force) force=true ;;
        force-quiet) quiet=true; force=true ;;
    esac
    local codex_home="${CODEX_HOME:-${HOME}/.codex}"
    local catalog="${codex_home}/fugu.json"
    local profile="${codex_home}/fugu.config.toml"
    local config="${codex_home}/config.toml"
    local wrapper="${HOME}/.local/bin/codex-fugu"
    local changed=false

    mkdir -p "$codex_home" "$(dirname "$wrapper")"

    local catalog_current=true
    local required_model
    if [[ ! -f "$catalog" ]]; then
        catalog_current=false
    else
        for required_model in \
            fugu \
            fugu-ultra \
            fugu-ultra-v1.0 \
            fugu-ultra-v1.1; do
            if ! grep -q "\"slug\": \"${required_model}\"" "$catalog" 2>/dev/null; then
                catalog_current=false
                break
            fi
        done
    fi
    if [[ "$force" == true || "$catalog_current" == false ]]; then
        sakana_write_fugu_catalog "$catalog"
        chmod 600 "$catalog"
        changed=true
    fi

    if [[ "$force" == true || ! -f "$profile" ]]; then
        sakana_write_fugu_profile "$profile" "$catalog"
        chmod 600 "$profile"
        changed=true
    fi

    if [[ ! -f "$config" ]]; then
        install -m 600 /dev/null "$config"
        changed=true
    fi

    if [[ "$force" == true && -f "$config" ]] && grep -q '^\[model_providers\.sakana\]' "$config" 2>/dev/null; then
        sakana_remove_provider_config "$config"
        changed=true
    fi

    if ! grep -q '^\[model_providers\.sakana\]' "$config" 2>/dev/null; then
        sakana_write_provider_config "$config"
        chmod 600 "$config"
        changed=true
    fi

    if [[ "$force" == true || ! -x "$wrapper" ]]; then
        sakana_write_codex_wrapper "$wrapper"
        changed=true
    fi

    if [[ "$quiet" != true || "$changed" == true ]]; then
        echo -e "${GREEN}✔ Sakana Fugu configurado no Codex${RESET}"
        echo -e "  ${DIM}${catalog}${RESET}"
        echo -e "  ${DIM}${profile}${RESET}"
        echo -e "  ${DIM}${config}${RESET}"
        echo -e "  ${DIM}${wrapper}${RESET}"
    fi
}

