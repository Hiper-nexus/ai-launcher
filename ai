    c=e.get("compute",{})
    print(f"  status: {s.get('state')}  ({c.get('instanceType')} {c.get('instanceSize')})")
    print(f"  réplicas: {s.get('readyReplica',0)}/{s.get('targetReplica',0)}")
PY
