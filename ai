run_with_timeout() {
    local seconds="${1:-}"
    shift || true
    if [[ "${1:-}" == "--" ]]; then
        shift
    fi
    if [[ -z "$seconds" || $# -eq 0 ]]; then
        echo "Uso: ai timeout <segundos> -- <comando> [args...]" >&2
        return 2
    fi
    if [[ ! "$seconds" =~ ^[0-9]+$ || "$seconds" -le 0 ]]; then
        echo "Erro: timeout inválido: $seconds" >&2
        return 2
    fi

    local timeout_bin
    timeout_bin="$(command -v timeout || command -v gtimeout || true)"
    if [[ -n "$timeout_bin" ]]; then
        "$timeout_bin" "$seconds" "$@"
        return $?
    fi

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$seconds" "$@" <<'PY'
import os
import signal
import subprocess
import sys
import threading
import time

timeout = int(sys.argv[1])
cmd = sys.argv[2:]
timed_out = [False]

try:
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        start_new_session=True,
    )
except FileNotFoundError:
    print(f"[erro] comando não encontrado: {cmd[0]}", file=sys.stderr)
    sys.exit(127)

def kill_proc():
    timed_out[0] = True
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    time.sleep(2)
    if proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

timer = threading.Timer(timeout, kill_proc)
timer.daemon = True
timer.start()
try:
    assert proc.stdout is not None
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
    rc = proc.wait()
finally:
    timer.cancel()

if timed_out[0]:
    print(f"\n[TIMEOUT] comando excedeu {timeout}s e foi encerrado.")
    sys.exit(124)
sys.exit(rc)
PY
        return $?
    fi

    echo "Aviso: timeout/gtimeout/python3 indisponível; executando sem limite: $*" >&2
    "$@"
}

# ── Codex Security ───────────────────────────────────────
# Scanner de vulnerabilidades da OpenAI (npm @openai/codex-security).
# Não é um agente interativo como as demais CLIs: tem subcomandos
# (scan, login, patch, export, scans...), então não passa pelo launch().

# O runtime do plugin exige Python 3.10+, mas o python3 do macOS costuma
# ser 3.9. Devolve um interpretador compatível quando o do PATH não serve
# (string vazia = o python3 do PATH já atende ou não há alternativa).
codex_security_python() {
    if command -v python3 &>/dev/null &&
       python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
        return 0
    fi
    local candidate
    for candidate in python3.14 python3.13 python3.12 python3.11 python3.10; do
        if command -v "$candidate" &>/dev/null; then
            command -v "$candidate"
            return 0
        fi
    done
    return 0
}

launch_codex_security() {
    if ! check_installed codex-security; then
        echo -e "${RED}Erro: codex-security não está instalado.${RESET}"
        echo "  Instale: npm install -g @openai/codex-security"
        echo "  Requer Node 22+ e Python 3.10+"
        exit 1
    fi

    local -a args=("$@")
    # Sem argumentos: escaneia o repo atual (comportamento do 'ai sec' puro).
    if [[ ${#args[@]} -eq 0 ]]; then
        args=(scan .)
    fi

    # Só os comandos de scan aceitam --python; injeta um interpretador
    # 3.10+ quando o python3 do PATH é antigo e o usuário não passou o dele.
    case "${args[0]}" in
        scan|bulk-scan)
            local has_python=false arg
            for arg in "${args[@]}"; do
                if [[ "$arg" == "--python" || "$arg" == --python=* ]]; then
                    has_python=true
                    break
                fi
            done
            if [[ "$has_python" == false ]]; then
                local py
                py=$(codex_security_python)
                [[ -n "$py" ]] && args+=(--python "$py")
            fi
            ;;
    esac

    save_history "Codex Security (${args[0]})"
    echo -e "${GREEN}Iniciando Codex Security:${RESET} codex-security ${args[*]}"
    echo ""
    exec codex-security "${args[@]}"
}

agy_add_workspace_flag() {
    local root="${1:-}"
    if [[ -z "$root" ]]; then
        root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    fi
    [[ -n "$root" && -d "$root" ]] || return 0

    local i next
    for i in "${!AGY_FLAGS[@]}"; do
        if [[ "${AGY_FLAGS[$i]}" == "--add-dir" ]]; then
            next=$((i + 1))
            if [[ $next -lt ${#AGY_FLAGS[@]} && "${AGY_FLAGS[$next]}" == "$root" ]]; then
                return 0
            fi
        fi
    done
    AGY_FLAGS+=(--add-dir "$root")
}

