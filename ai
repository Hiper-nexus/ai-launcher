# Contexto 32K. Não loga. Passa por Cloudflare (exige User-Agent de browser).
# Modelo default: Qwen2.5-Coder-32B abliterated (o melhor testado p/ RE).
FL_HOST="${AI_FL_HOST:-https://api.featherless.ai/v1}"
