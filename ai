# ── Contas Claude (troca de conta sem logout) ────────────
# O Claude Code guarda a credencial OAuth ativa no Keychain do macOS
# (service "Claude Code-credentials") e os metadados da conta no campo
# oauthAccount do ~/.claude.json. Cada conta salva pelo launcher vira:
#   - Keychain "ai-launcher-conta:<nome>"  → credencial (criptografada)
#   - ${ACCOUNTS_DIR}/<nome>.json          → email + oauthAccount (0600)
# Trocar = re-fotografar a ativa (refresh tokens rotacionam) e restaurar
# a escolhida no slot ativo. Sessões claude abertas mantêm a conta antiga.

_validate_account_name() {
    [[ "$1" =~ ^[a-z0-9_-]+$ ]]
}

_conta_require_deps() {
    if ! command -v security >/dev/null 2>&1; then
        echo -e "${RED}Erro: comando 'security' não encontrado (troca de contas é exclusiva do macOS).${RESET}"
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo -e "${RED}Erro: python3 é necessário para gerenciar contas.${RESET}"
        return 1
    fi
}

# Pausa o submenu até o usuário ler a saída (evita o menu re-desenhar por cima)
_conta_pausar() {
    [[ -t 0 ]] || return 0
    echo ""
    read -rp "$(echo -e "${DIM}  Enter para voltar ao menu...${RESET}")" _ || true
}

conta_active_email() {
    python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    with open(os.path.expanduser('~/.claude.json')) as f:
        print(json.load(f).get('oauthAccount', {}).get('emailAddress', ''))
except Exception:
    pass
PY
}

conta_meta_get() {
    # conta_meta_get <nome> <campo> → imprime o campo (vazio se ausente)
    local f="${ACCOUNTS_DIR}/$1.json"
    [[ -f "$f" ]] || return 1
    CONTA_META_FILE="$f" CONTA_META_KEY="$2" python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    with open(os.environ['CONTA_META_FILE']) as f:
        print(json.load(f).get(os.environ['CONTA_META_KEY'], ''))
except Exception:
    pass
PY
}

conta_keychain_has() {
    security find-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:$1" -a "$USER" >/dev/null 2>&1
}

conta_snapshot_to() {
    # Fotografa credencial ativa + oauthAccount como backup <nome>
    local nome="$1" cred
    cred=$(security find-generic-password -s "$CLAUDE_KEYCHAIN_SERVICE" -a "$USER" -w 2>/dev/null) || true
    if [[ -z "$cred" ]]; then
        echo -e "${RED}Nenhuma credencial ativa do Claude Code no Keychain.${RESET}"
        echo -e "  Faça login primeiro: ${BOLD}claude${RESET} → ${BOLD}/login${RESET}"
        return 1
    fi
    if ! security add-generic-password -U -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w "$cred" 2>/dev/null; then
        echo -e "${RED}Falha ao gravar backup '${nome}' no Keychain.${RESET}"
        return 1
    fi
    mkdir -p "$ACCOUNTS_DIR" && chmod 700 "$ACCOUNTS_DIR"
    CONTA_NOME="$nome" CONTA_DIR="$ACCOUNTS_DIR" python3 - <<'PY'
import json, os, datetime
home = os.path.expanduser('~')
oauth = {}
try:
    with open(os.path.join(home, '.claude.json')) as f:
        oauth = json.load(f).get('oauthAccount', {}) or {}
except Exception:
    pass
meta = {
    'email': oauth.get('emailAddress', ''),
    'oauthAccount': oauth,
    'savedAt': datetime.datetime.now().astimezone().isoformat(timespec='seconds'),
}
path = os.path.join(os.environ['CONTA_DIR'], os.environ['CONTA_NOME'] + '.json')
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    json.dump(meta, f, indent=2, ensure_ascii=False)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

conta_save() {
    local nome="${1:-}"
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta save <nome>${RESET}   ${DIM}ex.: ai conta save trabalho${RESET}"
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    conta_snapshot_to "$nome" || return 1
    local email
    email=$(conta_meta_get "$nome" email || true)
    echo -e "${GREEN}✔ Conta '${nome}' salva${RESET} ${DIM}(${email:-email desconhecido})${RESET}"
}

conta_find_by_email() {
    # Acha o nome salvo cujo email == $1
    local email="$1" f nome
    [[ -n "$email" ]] || return 1
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nome=$(basename "$f" .json)
        if [[ "$(conta_meta_get "$nome" email || true)" == "$email" ]]; then
            echo "$nome"
            return 0
        fi
    done
    return 1
}

conta_use() {
    local nome="${1:-}" email_ativo nome_ativo email_destino cred
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta use <nome>${RESET}"
        conta_list
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido.${RESET}"
        return 1
    fi
    if ! conta_keychain_has "$nome"; then
        echo -e "${RED}Conta '${nome}' não encontrada no Keychain.${RESET}"
        conta_list
        return 1
    fi

    email_ativo=$(conta_active_email)
    email_destino=$(conta_meta_get "$nome" email || true)

    # 1) Re-snapshot da conta ativa — o backup precisa do token de AGORA,
    #    não o de quando foi salvo (refresh tokens rotacionam).
    if nome_ativo=$(conta_find_by_email "$email_ativo"); then
        if ! conta_snapshot_to "$nome_ativo"; then
            echo -e "${RED}Falha ao atualizar snapshot da conta ativa ('${nome_ativo}'). Troca abortada.${RESET}"
            return 1
        fi
    elif [[ -n "$email_ativo" ]]; then
        echo -e "${YELLOW}A conta ativa (${email_ativo}) não está salva — sem backup ela exigirá novo login depois.${RESET}"
        if [[ -t 0 ]]; then
            local novo_nome
            read -rp "$(echo -e "  Salvar conta ativa como ${DIM}(vazio = não salvar)${RESET}: ")" novo_nome
            if [[ -n "$novo_nome" ]]; then
                conta_save "$novo_nome" || return 1
            fi
        else
            echo -e "  Salve antes: ${BOLD}ai conta save <nome>${RESET}"
            return 1
        fi
    fi

    # Já é a ativa? (o re-snapshot acima já deixou o backup fresco)
    if [[ -n "$email_destino" && "$email_destino" == "$email_ativo" ]]; then
        echo -e "${GREEN}✔ '${nome}' já é a conta ativa${RESET} ${DIM}(${email_ativo}) — snapshot atualizado.${RESET}"
        return 0
    fi

    # 2) Restaura a credencial escolhida no slot ativo do Claude Code
    cred=$(security find-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w 2>/dev/null) || true
    if [[ -z "$cred" ]]; then
        echo -e "${RED}Falha ao ler o backup '${nome}' do Keychain.${RESET}"
        return 1
    fi
    if ! security add-generic-password -U -s "$CLAUDE_KEYCHAIN_SERVICE" -a "$USER" -w "$cred" 2>/dev/null; then
        echo -e "${RED}Falha ao gravar credencial no slot ativo do Claude Code.${RESET}"
        return 1
    fi

    # 3) Atualiza oauthAccount no ~/.claude.json (backup .bak + escrita atômica)
    if [[ -f "${ACCOUNTS_DIR}/${nome}.json" ]]; then
        CONTA_NOME="$nome" CONTA_DIR="$ACCOUNTS_DIR" python3 - <<'PY' || echo -e "${YELLOW}⚠ Credencial trocada, mas falhou ao atualizar ~/.claude.json (o Claude reconcilia no próximo start).${RESET}"
import json, os, shutil
home = os.path.expanduser('~')
cfg_path = os.path.join(home, '.claude.json')
meta_path = os.path.join(os.environ['CONTA_DIR'], os.environ['CONTA_NOME'] + '.json')
with open(meta_path) as f:
    meta = json.load(f)
with open(cfg_path) as f:
    cfg = json.load(f)
shutil.copy2(cfg_path, cfg_path + '.bak-ai-launcher')
cfg['oauthAccount'] = meta.get('oauthAccount') or {}
tmp = cfg_path + '.tmp-ai-launcher'
with open(tmp, 'w') as f:
    json.dump(cfg, f, indent=2, ensure_ascii=False)
os.replace(tmp, cfg_path)
PY
    else
        echo -e "${YELLOW}⚠ Metadados de '${nome}' ausentes — credencial trocada sem atualizar ~/.claude.json.${RESET}"
    fi

    echo -e "${GREEN}✔ Conta ativa agora: ${BOLD}${nome}${RESET} ${DIM}(${email_destino:-?})${RESET}"
    echo -e "${DIM}  Sessões claude já abertas continuam na conta anterior — reinicie-as para usar a nova.${RESET}"
}

conta_list() {
    _conta_require_deps || return 1
    local email_ativo f nome email saved marker kc n=0
    email_ativo=$(conta_active_email)
    echo -e "${BOLD}${CYAN}👤 Contas Claude salvas${RESET}"
    echo ""
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(conta_meta_get "$nome" email || true)
        saved=$(conta_meta_get "$nome" savedAt || true)
        if conta_keychain_has "$nome"; then
            kc="${GREEN}✔${RESET}"
        else
            kc="${RED}✗ sem credencial${RESET}"
        fi
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}● ativa${RESET}"
        else
            marker="${DIM}○      ${RESET}"
        fi
        printf "  %b %-14s %-34s %b ${DIM}salva: %s${RESET}\n" "$marker" "$nome" "${email:-?}" "$kc" "${saved%%T*}"
    done
    if (( n == 0 )); then
        echo -e "  ${DIM}Nenhuma conta salva ainda.${RESET}"
        echo -e "  Salve a atual: ${BOLD}ai conta save <nome>${RESET}"
    fi
    if [[ -n "$email_ativo" ]] && ! conta_find_by_email "$email_ativo" >/dev/null; then
        echo ""
        echo -e "  ${YELLOW}Conta ativa (${email_ativo}) ainda não está salva.${RESET}"
    fi
    echo ""
}

conta_rm() {
    local nome="${1:-}"
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta rm <nome>${RESET}"
        return 1
    fi
    _validate_account_name "$nome" || { echo -e "${RED}Nome inválido.${RESET}"; return 1; }
    local achou=false
    if conta_keychain_has "$nome"; then
        security delete-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" >/dev/null 2>&1 && achou=true
    fi
    if [[ -f "${ACCOUNTS_DIR}/${nome}.json" ]]; then
        rm -f "${ACCOUNTS_DIR}/${nome}.json" && achou=true
    fi
    if [[ "$achou" == true ]]; then
        echo -e "${GREEN}✔ Backup '${nome}' removido${RESET} ${DIM}(a conta ativa não é afetada)${RESET}"
    else
        echo -e "${YELLOW}Conta '${nome}' não encontrada.${RESET}"
    fi
}

_usage_cache_get() {
    # $1 = chave  → imprime "u5 u7 reset" se houver entrada fresca
    # (TTL global, ou 'ttl' próprio da entrada quando presente)
    [[ -f "$USAGE_CACHE_FILE" ]] || return 1
    UC_FILE="$USAGE_CACHE_FILE" UC_KEY="$1" UC_TTL="$USAGE_CACHE_TTL" python3 - <<'PY' 2>/dev/null || return 1
import os, json, time
try:
    c = json.load(open(os.environ['UC_FILE']))
    e = c.get(os.environ['UC_KEY'])
    ttl = float(e.get('ttl', os.environ['UC_TTL'])) if e else 0
    if e and (time.time() - e['ts']) < ttl:
        print(e['line'])
    else:
        raise SystemExit(1)
except (OSError, ValueError, KeyError, AttributeError):
    raise SystemExit(1)
PY
}

_usage_cache_get_stale() {
    # $1 = chave → "u5 u7 reset|idade_min" da última leitura BOA, ignorando o
    # TTL — para exibir o dado mais recente quando a API está rate-limitada
    [[ -f "$USAGE_CACHE_FILE" ]] || return 1
    UC_FILE="$USAGE_CACHE_FILE" UC_KEY="$1" python3 - <<'PY' 2>/dev/null || return 1
import os, json, time
try:
    c = json.load(open(os.environ['UC_FILE']))
    e = c.get(os.environ['UC_KEY'])
    if e and e.get('line') and not str(e['line']).startswith('RATELIMIT'):
        print('%s|%d' % (e['line'], int((time.time() - e['ts']) / 60)))
    else:
        raise SystemExit(1)
except (OSError, ValueError, KeyError, AttributeError):
    raise SystemExit(1)
PY
}

_usage_cache_put() {
    # $1 = chave, $2 = linha, $3 = ttl opcional da entrada — escrita atômica
    command -v python3 >/dev/null 2>&1 || return 0
    UC_FILE="$USAGE_CACHE_FILE" UC_KEY="$1" UC_LINE="$2" UC_ENTRY_TTL="${3:-}" python3 - <<'PY' 2>/dev/null || true
import os, json, time
f = os.environ['UC_FILE']
try:
    c = json.load(open(f))
    if not isinstance(c, dict):
        c = {}
except (OSError, ValueError):
    c = {}
e = {'line': os.environ['UC_LINE'], 'ts': time.time()}
ttl = os.environ.get('UC_ENTRY_TTL')
if ttl:
    try:
        e['ttl'] = float(ttl)
    except ValueError:
        pass
c[os.environ['UC_KEY']] = e
tmp = f + '.tmp'
with open(tmp, 'w') as fh:
    json.dump(c, fh)
os.chmod(tmp, 0o600)
os.replace(tmp, f)
PY
}

_conta_usage_py() {
    # CONTA_BLOB (env): JSON do keychain do Claude → stdout "u5 u7 reset"
    # (+ "REFRESHED <blob>" se o accessToken foi renovado via refreshToken).
    # Diferente do Symbioose: renova o token OAuth quando dá 401, mantendo a
    # sessão viva em vez de só reportar indisponível.
    python3 - <<'PY'
import os, json, datetime, urllib.request, urllib.parse

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOKEN_URL = "https://console.anthropic.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"

def fetch(tok):
    # retorna (http_code, data|None, retry_after_s); code 0 = erro de rede
    req = urllib.request.Request(USAGE_URL)
    req.add_header("Authorization", "Bearer " + tok)
    req.add_header("anthropic-beta", "oauth-2025-04-20")
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", "ai-launcher")
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return 200, json.load(r), 0
    except urllib.error.HTTPError as e:
        try:
            ra = int(e.headers.get("Retry-After", "0"))
        except (TypeError, ValueError):
            ra = 0
        return e.code, None, ra
    except Exception:
        return 0, None, 0

def refresh(oauth):
    rt = oauth.get("refreshToken")
    if not rt:
        return None
    body = json.dumps({
        "grant_type": "refresh_token",
        "refresh_token": rt,
        "client_id": CLIENT_ID,
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=body, method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", "ai-launcher")  # console.anthropic.com bane UA do urllib (CF 1010)
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.load(r)
    except Exception:
        return None

def emit(u):
    fh = u.get("five_hour") or {}
    sd = u.get("seven_day") or {}
    u5 = fh.get("utilization")
    if u5 is None:
        return False
    u7 = sd.get("utilization") or 0
    reset = "?"
    try:
        reset = datetime.datetime.fromisoformat(fh.get("resets_at", "")).astimezone().strftime("%H:%M")
    except Exception:
        pass
    print(int(round(u5)), int(round(u7)), reset)
    return True

try:
    blob = json.loads(os.environ.get("CONTA_BLOB", ""))
    oauth = blob.get("claudeAiOauth") or {}
except Exception:
    raise SystemExit(1)

# Conta ativa: o Claude Code é o dono do token e o rotaciona — não renovamos
# para não competir (refresh aqui invalidaria a sessão dele). Backups inativos
# podem renovar com segurança.
is_active = os.environ.get("CONTA_IS_ACTIVE") == "1"

tok = oauth.get("accessToken")
code, u, ra = fetch(tok) if tok else (0, None, 0)
if u is not None and emit(u):
    raise SystemExit(0)
if code == 429:
    print("RATELIMIT %d" % max(ra, 60))  # rate limited: token bom, só esperar
    raise SystemExit(3)
if is_active:
    raise SystemExit(1)   # não renova a sessão ativa do Claude Code

new = refresh(oauth)
if new and new.get("access_token"):
    oauth["accessToken"] = new["access_token"]
    if new.get("refresh_token"):
        oauth["refreshToken"] = new["refresh_token"]
    if new.get("expires_in"):
        oauth["expiresAt"] = int(datetime.datetime.now().timestamp() * 1000 + new["expires_in"] * 1000)
    blob["claudeAiOauth"] = oauth
    code, u, ra = fetch(oauth["accessToken"])
    if u is not None and emit(u):
        print("REFRESHED " + json.dumps(blob))
        raise SystemExit(0)
    if code == 429:
        print("RATELIMIT %d" % max(ra, 60))
        raise SystemExit(3)
raise SystemExit(1)
PY
}

conta_usage_pct() {
    # conta_usage_pct [nome]  ("" = conta ativa)
    # stdout: "<pct_5h> <pct_7d> <reset_5h_local>" — return 1 se indisponível.
    # Renova e regrava o token quando expirado, mantendo a sessão utilizável.
    local nome="${1:-}" svc blob out linha1 refreshed cache_key
    if [[ -n "$nome" ]]; then
        svc="${ACCOUNT_KEYCHAIN_PREFIX}:${nome}"
        cache_key="claude:${nome}"
    else
        svc="$CLAUDE_KEYCHAIN_SERVICE"
        cache_key="claude:__active__"
    fi
    # Cache fresco evita o rate limit do endpoint
    if linha1=$(_usage_cache_get "$cache_key"); then
        printf '%s\n' "$linha1"
        return 0
    fi
    # Bloqueio de rate limit ainda em vigor? Não bate na rede (renovaria o ban)
    if _usage_cache_get "${cache_key}:rl" >/dev/null 2>&1; then
        printf 'RATELIMIT\n'
        return 0
    fi
    blob=$(security find-generic-password -s "$svc" -a "$USER" -w 2>/dev/null) || true
    [[ -z "$blob" ]] && return 1
    local is_active=0
    [[ -z "$nome" ]] && is_active=1
    local rc
    out=$(CONTA_BLOB="$blob" CONTA_IS_ACTIVE="$is_active" _conta_usage_py)
    rc=$?
    if (( rc == 3 )); then
        # Memoriza o bloqueio pelo tempo que a API pediu (cap 30 min)
        local ra
        ra=$(printf '%s\n' "$out" | sed -n 's/^RATELIMIT //p')
        [[ "$ra" =~ ^[0-9]+$ ]] || ra=120
        (( ra > 1800 )) && ra=1800
        _usage_cache_put "${cache_key}:rl" "RATELIMIT" "$ra"
        printf 'RATELIMIT\n'
        return 0
    fi
    (( rc != 0 )) && return 1
    linha1=$(printf '%s\n' "$out" | sed -n '1p')
    refreshed=$(printf '%s\n' "$out" | sed -n '2p')
    if [[ "$refreshed" == REFRESHED\ * ]]; then
        local novo_blob="${refreshed#REFRESHED }"
        security add-generic-password -U -s "$svc" -a "$USER" -w "$novo_blob" 2>/dev/null || true
    fi
    [[ -z "$linha1" ]] && return 1
    _usage_cache_put "$cache_key" "$linha1"
    printf '%s\n' "$linha1"
}

conta_status() {
    # Uso de cada conta salva (janela 5h / 7 dias), estilo Claude Switcher
    _conta_require_deps || return 1
    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${RED}curl é necessário para consultar uso.${RESET}"
