#!/usr/bin/env bash
# ai - Lançador rápido de CLIs de IA com flags pré-configuradas
# https://github.com/cleofasvolarehost/ai-launcher
#
# Uso: ai (interativo) | ai c/x/g (direto) | ai c "prompt aqui"

# Bash 4+ é necessário (declare -A). macOS vem com bash 3.2.
# Se detectar versão antiga, tenta re-exec com bash do Homebrew.
if (( BASH_VERSINFO[0] < 4 )); then
    for _new_bash in /opt/homebrew/bin/bash /usr/local/bin/bash /opt/local/bin/bash; do
        if [[ -x "$_new_bash" ]] && "$_new_bash" -c '(( BASH_VERSINFO[0] >= 4 ))' 2>/dev/null; then
            exec "$_new_bash" "$0" "$@"
        fi
    done
    echo "Erro: bash 4+ é necessário mas apenas bash ${BASH_VERSION} foi encontrado." >&2
    echo "  Instale via: brew install bash" >&2
    exit 1
fi

set -euo pipefail

AI_LAUNCHER_VERSION="1.8.0"

# ╔══════════════════════════════════════════════════════╗
# ║  CONFIGURE SUAS FLAGS AQUI                          ║
# ╚══════════════════════════════════════════════════════╝
CLAUDE_FLAGS=(--dangerously-skip-permissions)
CODEX_FLAGS=(--dangerously-bypass-approvals-and-sandbox)
GEMINI_FLAGS=(--yolo --model pro --skip-trust)
AGY_FLAGS=(--dangerously-skip-permissions)
AI_ORCHESTRATION_HOME="${AI_ORCHESTRATION_HOME:-${HOME}/.ai-orchestration}"
ORCHESTRATE_CMD="${ORCHESTRATE_CMD:-${HOME}/.local/bin/ai-orchestrate}"

# Variáveis de ambiente para cada CLI

# Flag de prompt para cada CLI (cada uma usa sintaxe diferente)
CLAUDE_PROMPT_FLAG="-p"
CODEX_PROMPT_FLAG="-p"
GEMINI_PROMPT_FLAG="-p"
AGY_PROMPT_FLAG="-p"

# Perfis do Claude (flags extras por modo)
get_claude_profile_flags() {
    case "$1" in
        fast)   echo "--model sonnet --effort low" ;;
        full)   echo "--model opus --effort max" ;;
        plan)   echo "--model opus --permission-mode plan" ;;
        sonnet) echo "--model sonnet" ;;
        opus)   echo "--model opus" ;;
        *)      return 1 ;;
    esac
}

# Status line é configurado via settings.json, não via flag CLI.
# Use: claude settings set statusLine '{model} | ⟨{cost}⟩ | ctx: {context_pct}'

# ── Providers alternativos ──────────────────────────────
# Arquivo de credenciais (criado automaticamente)
PROVIDERS_FILE="${HOME}/.local/share/ai-launcher/providers.conf"
mkdir -p "$(dirname "$PROVIDERS_FILE")"

# ── Contas Claude (troca sem logout) ─────────────────────
# Slot ativo do Claude Code no Keychain + metadados por conta
CLAUDE_KEYCHAIN_SERVICE="Claude Code-credentials"
ACCOUNT_KEYCHAIN_PREFIX="ai-launcher-conta"
ACCOUNTS_DIR="${HOME}/.local/share/ai-launcher/accounts"
# Auto-switch: ao lançar o Claude, se a janela de 5h da conta ativa estiver
# >= threshold, troca para outra conta salva com quota (estilo Claude Switcher)
CONTA_AUTO_SWITCH="${AI_CONTA_AUTO_SWITCH:-true}"
CONTA_AUTO_THRESHOLD="${AI_CONTA_AUTO_THRESHOLD:-100}"
CLAUDE_USAGE_URL="https://api.anthropic.com/api/oauth/usage"

# Providers disponíveis: nome=base_url (URLs confirmadas pelo multi-claude)
declare -A PROVIDER_URLS=(
    [anthropic]=""
    [openrouter]="https://openrouter.ai/api"
    [deepseek]="https://api.deepseek.com/anthropic"
    [ollama]="http://localhost:11434"
    [lmstudio]="http://localhost:1234"
    [litellm]="http://localhost:4000"
)

# Modelos default por provider
declare -A PROVIDER_MODELS=(
    [anthropic]=""
    [openrouter]="anthropic/claude-sonnet-4"
    [deepseek]="deepseek-chat"
    [ollama]="qwen2.5-coder:32b"
    [lmstudio]="loaded-model"
    [litellm]="gpt-4o"
)

# Env vars extras por provider (timeout, tráfego, etc.)
declare -A PROVIDER_EXTRA_ENV=(
    [anthropic]=""
    [openrouter]=""
    [deepseek]="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 API_TIMEOUT_MS=600000"
    [ollama]="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 API_TIMEOUT_MS=600000"
    [lmstudio]="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 API_TIMEOUT_MS=600000"
    [litellm]="CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
)

_validate_provider_name() {
    [[ "$1" =~ ^[a-z0-9_-]+$ ]]
}

provider_load_key() {
    local provider="$1"
    _validate_provider_name "$provider" || return 1
    if [[ -f "$PROVIDERS_FILE" ]]; then
        grep -F "${provider}=" "$PROVIDERS_FILE" 2>/dev/null | grep "^${provider}=" | cut -d= -f2-
    fi
}

provider_save_key() {
    local provider="$1" key="$2"
    _validate_provider_name "$provider" || { echo -e "${RED}Nome de provider inválido.${RESET}"; return 1; }
    # Garante arquivo com permissões restritivas antes de escrever
    if [[ ! -f "$PROVIDERS_FILE" ]]; then
        install -m 600 /dev/null "$PROVIDERS_FILE"
    fi
    # Remove linha antiga usando grep para evitar injection no sed
    local tmpfile
    tmpfile=$(mktemp)
    trap "rm -f '$tmpfile'" RETURN
    grep -v "^${provider}=" "$PROVIDERS_FILE" > "$tmpfile" 2>/dev/null || true
    echo "${provider}=${key}" >> "$tmpfile"
    mv "$tmpfile" "$PROVIDERS_FILE"
    chmod 600 "$PROVIDERS_FILE"
    trap - RETURN
}

provider_setup_env() {
    local provider="$1"
    if [[ "$provider" == "anthropic" || -z "$provider" ]]; then
        return
    fi

    local base_url="${PROVIDER_URLS[$provider]:-}"
    if [[ -z "$base_url" ]]; then
        echo -e "${RED}Provider desconhecido: ${provider}${RESET}"
        return 1
    fi

    local api_key
    api_key=$(provider_load_key "$provider") || true

    # Providers locais não precisam de key real
    case "$provider" in
        ollama|lmstudio|litellm)
            api_key="${api_key:-${provider}}"
            ;;
        *)
            if [[ -z "$api_key" ]]; then
                if [[ -t 0 ]]; then
                    read -rsp "$(echo -e "  ${BOLD}API Key para ${provider}:${RESET} ")" api_key
                    echo ""
                    if [[ -n "$api_key" ]]; then
                        provider_save_key "$provider" "$api_key"
                        echo -e "${GREEN}✔ Key salva em ${PROVIDERS_FILE}${RESET}"
                    fi
                else
                    echo -e "${RED}Erro: API key para ${provider} não configurada.${RESET}"
                    echo "  Configure: ai p add ${provider}"
                    return 1
                fi
            fi
            ;;
    esac

    # Configura env vars conforme padrão do Claude Code
    # AUTH_TOKEN é o padrão para providers terceiros (não API_KEY)
    export ANTHROPIC_BASE_URL="$base_url"
    unset ANTHROPIC_API_KEY 2>/dev/null || true

    case "$provider" in
        openrouter)
            export OPENROUTER_API_KEY="$api_key"
            export ANTHROPIC_AUTH_TOKEN="$api_key"
            ;;
        *)
            export ANTHROPIC_AUTH_TOKEN="$api_key"
            ;;
    esac

    # Seta env vars extras do provider (timeout, disable traffic, etc.)
    local extras="${PROVIDER_EXTRA_ENV[$provider]:-}"
    if [[ -n "$extras" ]]; then
        local -a extra_pairs
        read -ra extra_pairs <<< "$extras"
        local pair key val
        for pair in "${extra_pairs[@]}"; do
            key="${pair%%=*}"
            val="${pair#*=}"
            [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
            export "$key"="$val"
        done
    fi

    # Model env vars para forçar o modelo em todos os contextos
    local model="${PROVIDER_MODELS[$provider]:-}"
    if [[ -n "$model" ]]; then
        export ANTHROPIC_MODEL="$model"
    fi

    echo -e "${CYAN}Provider:${RESET} ${provider} → ${base_url}"
}

provider_list() {
    echo -e "${BOLD}${CYAN}"
    echo "  ┌──────────────────────────────────────────────────┐"
    echo "  │         🔌 Providers Configurados                 │"
    echo "  └──────────────────────────────────────────────────┘"
    echo -e "${RESET}"

    for p in "${!PROVIDER_URLS[@]}"; do
        local url="${PROVIDER_URLS[$p]}"
        local key_status
        if [[ "$p" == "anthropic" ]]; then
            key_status="${GREEN}OAuth/default${RESET}"
        elif [[ "$p" == "ollama" || "$p" == "lmstudio" || "$p" == "litellm" ]]; then
            key_status="${DIM}local (sem key)${RESET}"
        elif [[ -n "$(provider_load_key "$p")" ]]; then
            key_status="${GREEN}✔ key salva${RESET}"
        else
            key_status="${YELLOW}✗ sem key${RESET}"
        fi
        local model="${PROVIDER_MODELS[$p]:-}"
        printf "  %-12s %b  ${DIM}model: %s${RESET}\n" "$p" "$key_status" "${model:-default}"
    done
    echo ""
}

# ── Contas Claude (troca de conta sem logout) ────────────
# O Claude Code guarda a credencial OAuth ativa no Keychain do macOS
# (service "Claude Code-credentials") e os metadados da conta no campo
# oauthAccount do ~/.claude.json. Cada conta salva pelo launcher vira:
#   - Keychain "ai-launcher-conta:<nome>"  → credencial (criptografada)
#   - ${ACCOUNTS_DIR}/<nome>.json          → email + oauthAccount (0600)
# Trocar = re-fotografar a ativa (refresh tokens rotacionam) e restaurar
# a escolhida no slot ativo. Sessões claude abertas mantêm a conta antiga.

_validate_account_name() {
    [[ "$1" =~ ^[a-z0-9_-]+$ ]]
}

_conta_require_deps() {
    if ! command -v security >/dev/null 2>&1; then
        echo -e "${RED}Erro: comando 'security' não encontrado (troca de contas é exclusiva do macOS).${RESET}"
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo -e "${RED}Erro: python3 é necessário para gerenciar contas.${RESET}"
        return 1
    fi
}

conta_active_email() {
    python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    with open(os.path.expanduser('~/.claude.json')) as f:
        print(json.load(f).get('oauthAccount', {}).get('emailAddress', ''))
except Exception:
    pass
PY
}

conta_meta_get() {
    # conta_meta_get <nome> <campo> → imprime o campo (vazio se ausente)
    local f="${ACCOUNTS_DIR}/$1.json"
    [[ -f "$f" ]] || return 1
    CONTA_META_FILE="$f" CONTA_META_KEY="$2" python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    with open(os.environ['CONTA_META_FILE']) as f:
        print(json.load(f).get(os.environ['CONTA_META_KEY'], ''))
except Exception:
    pass
PY
}

conta_keychain_has() {
    security find-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:$1" -a "$USER" >/dev/null 2>&1
}

conta_snapshot_to() {
    # Fotografa credencial ativa + oauthAccount como backup <nome>
    local nome="$1" cred
    cred=$(security find-generic-password -s "$CLAUDE_KEYCHAIN_SERVICE" -a "$USER" -w 2>/dev/null) || true
    if [[ -z "$cred" ]]; then
        echo -e "${RED}Nenhuma credencial ativa do Claude Code no Keychain.${RESET}"
        echo -e "  Faça login primeiro: ${BOLD}claude${RESET} → ${BOLD}/login${RESET}"
        return 1
    fi
    if ! security add-generic-password -U -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w "$cred" 2>/dev/null; then
        echo -e "${RED}Falha ao gravar backup '${nome}' no Keychain.${RESET}"
        return 1
    fi
    mkdir -p "$ACCOUNTS_DIR" && chmod 700 "$ACCOUNTS_DIR"
    CONTA_NOME="$nome" CONTA_DIR="$ACCOUNTS_DIR" python3 - <<'PY'
import json, os, datetime
home = os.path.expanduser('~')
oauth = {}
try:
    with open(os.path.join(home, '.claude.json')) as f:
        oauth = json.load(f).get('oauthAccount', {}) or {}
except Exception:
    pass
meta = {
    'email': oauth.get('emailAddress', ''),
    'oauthAccount': oauth,
    'savedAt': datetime.datetime.now().astimezone().isoformat(timespec='seconds'),
}
path = os.path.join(os.environ['CONTA_DIR'], os.environ['CONTA_NOME'] + '.json')
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    json.dump(meta, f, indent=2, ensure_ascii=False)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

conta_save() {
    local nome="${1:-}"
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta save <nome>${RESET}   ${DIM}ex.: ai conta save trabalho${RESET}"
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    conta_snapshot_to "$nome" || return 1
    local email
    email=$(conta_meta_get "$nome" email || true)
    echo -e "${GREEN}✔ Conta '${nome}' salva${RESET} ${DIM}(${email:-email desconhecido})${RESET}"
}

conta_find_by_email() {
    # Acha o nome salvo cujo email == $1
    local email="$1" f nome
    [[ -n "$email" ]] || return 1
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nome=$(basename "$f" .json)
        if [[ "$(conta_meta_get "$nome" email || true)" == "$email" ]]; then
            echo "$nome"
            return 0
        fi
    done
    return 1
}

conta_use() {
    local nome="${1:-}" email_ativo nome_ativo email_destino cred
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta use <nome>${RESET}"
        conta_list
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido.${RESET}"
        return 1
    fi
    if ! conta_keychain_has "$nome"; then
        echo -e "${RED}Conta '${nome}' não encontrada no Keychain.${RESET}"
        conta_list
        return 1
    fi

    email_ativo=$(conta_active_email)
    email_destino=$(conta_meta_get "$nome" email || true)

    # 1) Re-snapshot da conta ativa — o backup precisa do token de AGORA,
    #    não o de quando foi salvo (refresh tokens rotacionam).
    if nome_ativo=$(conta_find_by_email "$email_ativo"); then
        if ! conta_snapshot_to "$nome_ativo"; then
            echo -e "${RED}Falha ao atualizar snapshot da conta ativa ('${nome_ativo}'). Troca abortada.${RESET}"
            return 1
        fi
    elif [[ -n "$email_ativo" ]]; then
        echo -e "${YELLOW}A conta ativa (${email_ativo}) não está salva — sem backup ela exigirá novo login depois.${RESET}"
        if [[ -t 0 ]]; then
            local novo_nome
            read -rp "$(echo -e "  Salvar conta ativa como ${DIM}(vazio = não salvar)${RESET}: ")" novo_nome
            if [[ -n "$novo_nome" ]]; then
                conta_save "$novo_nome" || return 1
            fi
        else
            echo -e "  Salve antes: ${BOLD}ai conta save <nome>${RESET}"
            return 1
        fi
    fi

    # Já é a ativa? (o re-snapshot acima já deixou o backup fresco)
    if [[ -n "$email_destino" && "$email_destino" == "$email_ativo" ]]; then
        echo -e "${GREEN}✔ '${nome}' já é a conta ativa${RESET} ${DIM}(${email_ativo}) — snapshot atualizado.${RESET}"
        return 0
    fi

    # 2) Restaura a credencial escolhida no slot ativo do Claude Code
    cred=$(security find-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w 2>/dev/null) || true
    if [[ -z "$cred" ]]; then
        echo -e "${RED}Falha ao ler o backup '${nome}' do Keychain.${RESET}"
        return 1
    fi
    if ! security add-generic-password -U -s "$CLAUDE_KEYCHAIN_SERVICE" -a "$USER" -w "$cred" 2>/dev/null; then
        echo -e "${RED}Falha ao gravar credencial no slot ativo do Claude Code.${RESET}"
        return 1
    fi

    # 3) Atualiza oauthAccount no ~/.claude.json (backup .bak + escrita atômica)
    if [[ -f "${ACCOUNTS_DIR}/${nome}.json" ]]; then
        CONTA_NOME="$nome" CONTA_DIR="$ACCOUNTS_DIR" python3 - <<'PY' || echo -e "${YELLOW}⚠ Credencial trocada, mas falhou ao atualizar ~/.claude.json (o Claude reconcilia no próximo start).${RESET}"
import json, os, shutil
home = os.path.expanduser('~')
cfg_path = os.path.join(home, '.claude.json')
meta_path = os.path.join(os.environ['CONTA_DIR'], os.environ['CONTA_NOME'] + '.json')
with open(meta_path) as f:
    meta = json.load(f)
with open(cfg_path) as f:
    cfg = json.load(f)
shutil.copy2(cfg_path, cfg_path + '.bak-ai-launcher')
cfg['oauthAccount'] = meta.get('oauthAccount') or {}
tmp = cfg_path + '.tmp-ai-launcher'
with open(tmp, 'w') as f:
    json.dump(cfg, f, indent=2, ensure_ascii=False)
os.replace(tmp, cfg_path)
PY
    else
        echo -e "${YELLOW}⚠ Metadados de '${nome}' ausentes — credencial trocada sem atualizar ~/.claude.json.${RESET}"
    fi

    echo -e "${GREEN}✔ Conta ativa agora: ${BOLD}${nome}${RESET} ${DIM}(${email_destino:-?})${RESET}"
    echo -e "${DIM}  Sessões claude já abertas continuam na conta anterior — reinicie-as para usar a nova.${RESET}"
}

conta_list() {
    _conta_require_deps || return 1
    local email_ativo f nome email saved marker kc n=0
    email_ativo=$(conta_active_email)
    echo -e "${BOLD}${CYAN}👤 Contas Claude salvas${RESET}"
    echo ""
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(conta_meta_get "$nome" email || true)
        saved=$(conta_meta_get "$nome" savedAt || true)
        if conta_keychain_has "$nome"; then
            kc="${GREEN}✔${RESET}"
        else
            kc="${RED}✗ sem credencial${RESET}"
        fi
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}● ativa${RESET}"
        else
            marker="${DIM}○      ${RESET}"
        fi
        printf "  %b %-14s %-34s %b ${DIM}salva: %s${RESET}\n" "$marker" "$nome" "${email:-?}" "$kc" "${saved%%T*}"
    done
    if (( n == 0 )); then
        echo -e "  ${DIM}Nenhuma conta salva ainda.${RESET}"
        echo -e "  Salve a atual: ${BOLD}ai conta save <nome>${RESET}"
    fi
    if [[ -n "$email_ativo" ]] && ! conta_find_by_email "$email_ativo" >/dev/null; then
        echo ""
        echo -e "  ${YELLOW}Conta ativa (${email_ativo}) ainda não está salva.${RESET}"
    fi
    echo ""
}

conta_rm() {
    local nome="${1:-}"
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai conta rm <nome>${RESET}"
        return 1
    fi
    _validate_account_name "$nome" || { echo -e "${RED}Nome inválido.${RESET}"; return 1; }
    local achou=false
    if conta_keychain_has "$nome"; then
        security delete-generic-password -s "${ACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" >/dev/null 2>&1 && achou=true
    fi
    if [[ -f "${ACCOUNTS_DIR}/${nome}.json" ]]; then
        rm -f "${ACCOUNTS_DIR}/${nome}.json" && achou=true
    fi
    if [[ "$achou" == true ]]; then
        echo -e "${GREEN}✔ Backup '${nome}' removido${RESET} ${DIM}(a conta ativa não é afetada)${RESET}"
    else
        echo -e "${YELLOW}Conta '${nome}' não encontrada.${RESET}"
    fi
}

conta_usage_pct() {
    # conta_usage_pct [nome]  ("" = conta ativa)
    # stdout: "<pct_5h> <pct_7d> <reset_5h_local>" — return 1 se indisponível
    local nome="${1:-}" svc tok
    if [[ -n "$nome" ]]; then
        svc="${ACCOUNT_KEYCHAIN_PREFIX}:${nome}"
    else
        svc="$CLAUDE_KEYCHAIN_SERVICE"
    fi
    tok=$(security find-generic-password -s "$svc" -a "$USER" -w 2>/dev/null | python3 -c "
import sys, json
try:
    print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])
except Exception:
    pass" 2>/dev/null) || true
    [[ -z "$tok" ]] && return 1
    curl -s -m 6 -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" \
        "$CLAUDE_USAGE_URL" 2>/dev/null | python3 -c "
import sys, json, datetime
d = json.load(sys.stdin)
fh = d.get('five_hour') or {}
sd = d.get('seven_day') or {}
u5 = fh.get('utilization')
if u5 is None:
    raise SystemExit(1)
u7 = sd.get('utilization') or 0
reset = '?'
try:
    r = datetime.datetime.fromisoformat(fh.get('resets_at', ''))
    reset = r.astimezone().strftime('%H:%M')
except Exception:
    pass
print(int(round(u5)), int(round(u7)), reset)" 2>/dev/null || return 1
}

conta_status() {
    # Uso de cada conta salva (janela 5h / 7 dias), estilo Claude Switcher
    _conta_require_deps || return 1
    if ! command -v curl >/dev/null 2>&1; then
        echo -e "${RED}curl é necessário para consultar uso.${RESET}"
        return 1
    fi
    local email_ativo f nome email out u5 u7 reset marker cor n=0
    email_ativo=$(conta_active_email)
    echo -e "${BOLD}${CYAN}📊 Uso das contas Claude${RESET} ${DIM}(janela 5h / 7 dias)${RESET}"
    echo ""
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(conta_meta_get "$nome" email || true)
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}●${RESET}"
            out=$(conta_usage_pct "" || true)     # ativa: token do slot, mais fresco
        else
            marker="${DIM}○${RESET}"
            out=$(conta_usage_pct "$nome" || true)
        fi
        if [[ -n "$out" ]]; then
            u5=$(echo "$out" | cut -d' ' -f1)
            u7=$(echo "$out" | cut -d' ' -f2)
            reset=$(echo "$out" | cut -d' ' -f3)
            cor="$GREEN"
            (( u5 >= 80 )) && cor="$YELLOW"
            (( u5 >= 100 )) && cor="$RED"
            printf "  %b %-14s %-30s 5h: %b%3d%%%b  7d: %3d%%  ${DIM}reseta %s${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$cor" "$u5" "$RESET" "$u7" "$reset"
        else
            printf "  %b %-14s %-30s ${DIM}uso indisponível (token antigo? reative: ai conta use %s)${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$nome"
        fi
    done
    (( n == 0 )) && echo -e "  ${DIM}Nenhuma conta salva. Adicione: ${RESET}${BOLD}ai conta add <nome>${RESET}"
    echo ""
}

conta_autoswitch_if_needed() {
    # Antes de lançar o Claude: se a janela de 5h da conta ativa atingiu o
    # threshold, troca para outra conta salva com quota. Fail-open: problema
    # de rede/API nunca bloqueia o launch.
    [[ "$CONTA_AUTO_SWITCH" == "true" ]] || return 0
    command -v curl >/dev/null 2>&1 || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    command -v security >/dev/null 2>&1 || return 0
    local f nomes=()
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nomes+=("$(basename "$f" .json)")
    done
    (( ${#nomes[@]} >= 2 )) || return 0

    local out u5
    out=$(conta_usage_pct "" || true)
    [[ -z "$out" ]] && return 0
    u5=${out%% *}
    (( u5 >= CONTA_AUTO_THRESHOLD )) || return 0

    local email_ativo nome_ativo
    email_ativo=$(conta_active_email)
    nome_ativo=$(conta_find_by_email "$email_ativo" || true)
    [[ -z "$nome_ativo" ]] && return 0   # ativa não salva: não arrisca trocar

    echo -e "${YELLOW}⚠ Conta '${nome_ativo}' está em ${u5}% da janela de 5h — procurando outra conta...${RESET}"
    local nome alvo="" fallback="" out2 u2
    for nome in "${nomes[@]}"; do
        [[ "$nome" == "$nome_ativo" ]] && continue
        if out2=$(conta_usage_pct "$nome"); then
            u2=${out2%% *}
            if (( u2 < CONTA_AUTO_THRESHOLD )); then
                alvo="$nome"
                echo -e "  ${GREEN}→ '${nome}' está em ${u2}% — trocando.${RESET}"
                break
            fi
        else
            [[ -z "$fallback" ]] && fallback="$nome"
        fi
    done
    if [[ -z "$alvo" && -n "$fallback" ]]; then
        alvo="$fallback"
        echo -e "  ${DIM}→ uso de '${alvo}' não verificável; tentando mesmo assim.${RESET}"
    fi
    if [[ -z "$alvo" ]]; then
        echo -e "  ${RED}Todas as contas salvas estão no limite — seguindo na atual.${RESET}"
        return 0
    fi
    conta_use "$alvo" || true
}

conta_add() {
    # Fluxo guiado: protege a conta ativa, loga na NOVA via 'claude auth login',
    # salva e oferece voltar. Rollback automático se o login falhar.
    local nome="${1:-}"
    _conta_require_deps || return 1
    if ! command -v claude >/dev/null 2>&1; then
        echo -e "${RED}Claude Code CLI não encontrado.${RESET}"
        return 1
    fi
    if [[ ! -t 0 ]]; then
        echo -e "${RED}'ai conta add' precisa de terminal interativo (o login abre o navegador).${RESET}"
        return 1
    fi
    if [[ -z "$nome" ]]; then
        read -rp "$(echo -e "  Nome para a ${BOLD}nova${RESET} conta ${DIM}(ex.: pessoal, trabalho)${RESET}: ")" nome
    fi
    [[ -z "$nome" ]] && { echo -e "${DIM}cancelado${RESET}"; return 1; }
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    if conta_keychain_has "$nome"; then
        echo -e "${RED}Já existe uma conta salva chamada '${nome}'.${RESET} ${DIM}(remova antes: ai conta rm ${nome})${RESET}"
        return 1
    fi

    # 1) Protege a conta ativa antes de deslogar
    local email_antes nome_anterior=""
    email_antes=$(conta_active_email)
    if [[ -n "$email_antes" ]]; then
        if nome_anterior=$(conta_find_by_email "$email_antes"); then
            conta_snapshot_to "$nome_anterior" || return 1
        else
            local salvar_como
            read -rp "$(echo -e "  A conta ativa (${email_antes}) precisa ser salva antes. Nome para ela: ")" salvar_como
            [[ -z "$salvar_como" ]] && { echo -e "${RED}cancelado — nada foi alterado.${RESET}"; return 1; }
            conta_save "$salvar_como" || return 1
            nome_anterior="$salvar_como"
        fi
    fi

    # 2) Login na conta nova (única vez que o navegador é necessário)
    echo ""
    echo -e "  ${BOLD}No navegador que vai abrir, entre com a conta NOVA.${RESET}"
    [[ -n "$nome_anterior" ]] && echo -e "  ${DIM}(a conta '${nome_anterior}' já está protegida no Keychain)${RESET}"
    echo ""
    claude auth logout >/dev/null 2>&1 || true
    if ! claude auth login; then
        echo -e "${RED}Login falhou ou foi cancelado.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            echo -e "  Restaurando '${nome_anterior}'..."
            conta_use "$nome_anterior" || true
        fi
        return 1
    fi

    # 3) Valida e salva a conta nova
    local email_depois
    email_depois=$(conta_active_email)
    if [[ -z "$email_depois" ]]; then
        echo -e "${RED}Não foi possível confirmar o login.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            conta_use "$nome_anterior" || true
        fi
        return 1
    fi
    if [[ -n "$email_antes" && "$email_depois" == "$email_antes" ]]; then
        echo -e "${YELLOW}Você entrou na MESMA conta (${email_depois}) — nada novo para salvar.${RESET}"
        conta_snapshot_to "$nome_anterior" >/dev/null 2>&1 || true
        return 1
    fi
    conta_save "$nome" || return 1

    # 4) Ficar na nova ou voltar?
    echo ""
    local ficar
    read -rp "$(echo -e "  ${BOLD}1)${RESET} Continuar na '${nome}'   ${BOLD}2)${RESET} Voltar para '${nome_anterior:-anterior}'   [1]: ")" ficar
    if [[ "$ficar" == "2" && -n "$nome_anterior" ]]; then
        conta_use "$nome_anterior"
    else
        echo -e "${GREEN}✔ Usando '${nome}' (${email_depois}).${RESET}"
    fi
}

conta_menu() {
    _conta_require_deps || return 1
    conta_list
    if [[ ! -t 0 ]]; then
        return 0
    fi
    local nomes=() f
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nomes+=("$(basename "$f" .json)")
    done
    if (( ${#nomes[@]} == 0 )); then
        local salvar
        read -rp "$(echo -e "  Salvar a conta ativa agora? Nome ${DIM}(vazio = sair)${RESET}: ")" salvar
        [[ -n "$salvar" ]] && conta_save "$salvar"
        echo -e "  ${DIM}Para cadastrar a segunda conta: ${RESET}${BOLD}ai conta add <nome>${RESET}"
        return 0
    fi
    local i=1 escolha
    echo -e "  ${BOLD}Trocar para:${RESET}"
    for nome in "${nomes[@]}"; do
        printf "  ${BOLD}%d)${RESET} %s\n" "$i" "$nome"
        i=$((i+1))
    done
    echo -e "  ${BOLD}a)${RESET} Adicionar conta nova (login guiado)"
    echo -e "  ${BOLD}u)${RESET} Ver uso das contas (5h/7d)"
    echo -e "  ${BOLD}s)${RESET} Salvar conta ativa com novo nome"
    echo -e "  ${DIM}0) Voltar${RESET}"
    read -rp "Escolha: " escolha
    case "$escolha" in
        0|"") return 0 ;;
        a|A) conta_add ;;
        u|U) conta_status ;;
        s|S)
            local novo
            read -rp "  Nome para a conta ativa: " novo
            [[ -n "$novo" ]] && conta_save "$novo"
            ;;
        *)
            if [[ "$escolha" =~ ^[0-9]+$ ]] && (( escolha >= 1 && escolha <= ${#nomes[@]} )); then
                conta_use "${nomes[$((escolha-1))]}"
            else
                echo "Opção inválida."
                return 1
            fi
            ;;
    esac
}

