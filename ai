# ── Funções utilitárias ──────────────────────────────────

get_version() {
    local cmd="$1"
    if command -v "$cmd" &>/dev/null; then
        "$cmd" --version 2>/dev/null | head -1 || echo "?"
    else
        echo "-"
    fi
}

check_installed() {
    command -v "$1" &>/dev/null
}

status_icon() {
    local cmd="$1"
    if ! check_installed "$cmd"; then
        echo -e "${RED}✗ não instalado${RESET}"
    else
        echo -e "${GREEN}✔${RESET}"
    fi
}

save_history() {
    echo "$(date '+%Y-%m-%d %H:%M') | $1" >> "$HISTORY_FILE"
}

show_last_used() {
    if [[ -f "$HISTORY_FILE" ]]; then
        local last
        last=$(tail -1 "$HISTORY_FILE")
        echo -e "  ${DIM}Último uso: ${last}${RESET}"
    fi
}

normalize_choice() {
    printf '%s' "${1:-}" | tr -d '[:space:]'
}

launch() {
    local name="$1" cmd="$2" prompt_flag="$3"
    local flags_name="$4"
    shift 4

    local flags_ref=()
    case "$flags_name" in
        CLAUDE_FLAGS) flags_ref=("${CLAUDE_FLAGS[@]}") ;;
        CODEX_FLAGS)  flags_ref=("${CODEX_FLAGS[@]}") ;;
        GEMINI_FLAGS) flags_ref=("${GEMINI_FLAGS[@]}") ;;
        AGY_FLAGS)    flags_ref=("${AGY_FLAGS[@]+"${AGY_FLAGS[@]}"}") ;;
        *)
            echo -e "${RED}Erro interno: array de flags desconhecida (${flags_name}).${RESET}"
            exit 1
            ;;
    esac

    if ! check_installed "$cmd"; then
        echo -e "${RED}Erro: ${cmd} não está instalado.${RESET}"
        case "$cmd" in
            claude) echo "  Instale: npm install -g @anthropic-ai/claude-code" ;;
            codex)  echo "  Instale: npm install -g @openai/codex" ;;
            gemini) echo "  Instale: sudo npm install -g @google/gemini-cli" ;;
            agy)    echo "  Instale: curl -fsSL https://antigravity.google/cli/install.sh | bash" ;;
        esac
        exit 1
    fi

    save_history "$name${_active_provider:+ [${_active_provider}]}"

    # Cópia local para não mutar o array do caller
    local -a final_flags=("${flags_ref[@]+"${flags_ref[@]}"}")

    if [[ $# -gt 0 ]]; then
        local prompt="$*"
        echo -e "${GREEN}Iniciando ${name}:${RESET} ${cmd} ${final_flags[*]+"${final_flags[*]}"} ${prompt_flag} \"${prompt}\""
        echo ""
        exec "$cmd" ${final_flags[@]+"${final_flags[@]}"} "$prompt_flag" "$prompt"
    else
        echo -e "${GREEN}Iniciando ${name}:${RESET} ${cmd} ${final_flags[*]+"${final_flags[*]}"}"
        echo ""
        exec "$cmd" ${final_flags[@]+"${final_flags[@]}"}
    fi
}

orchestration_missing_cmd() {
    echo -e "${RED}Erro: runner de orquestração não encontrado: ${ORCHESTRATE_CMD}${RESET}"
    echo "  Configurado em ORCHESTRATE_CMD: ${ORCHESTRATE_CMD}"
    echo "  Padrão: ${HOME}/.local/bin/ai-orchestrate"
    echo "  Ajuste ORCHESTRATE_CMD ou reinstale a camada de orquestração."
}

require_orchestrate_cmd() {
    if ! check_installed "$ORCHESTRATE_CMD"; then
        orchestration_missing_cmd
        exit 1
    fi
}

orchestration_script_path() {
    printf '%s/scripts/%s.sh' "$AI_ORCHESTRATION_HOME" "$1"
}

run_orchestration_script() {
    local script_name="$1"
    shift
    local script_path
    script_path=$(orchestration_script_path "$script_name")
    if [[ ! -x "$script_path" ]]; then
        echo -e "${RED}Erro: script de orquestração indisponível: ${script_path}${RESET}"
        echo "  AI_ORCHESTRATION_HOME atual: ${AI_ORCHESTRATION_HOME}"
        echo "  Padrão: ${HOME}/.ai-orchestration"
        echo "  Reinstale ou restaure a camada de orquestração antes de usar este subcomando."
        exit 1
    fi
    exec "$script_path" "$@"
}

orchestration_has_execute_flag() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--execute" ]] && return 0
    done
    return 1
}

setup_orchestration_provider_if_needed() {
    if [[ -z "${_active_provider:-}" ]]; then
        return
    fi
    if orchestration_has_execute_flag "$@"; then
        provider_setup_env "$_active_provider" || exit 1
    fi
}

launch_orchestration() {
    parse_global_flags "$@"
    set -- "${_REMAINING_ARGS[@]+"${_REMAINING_ARGS[@]}"}"

    local subcmd="${1:-}"
    case "$subcmd" in
        status)
            shift
            run_orchestration_script status "$@"
            ;;
        collect)
            shift
            run_orchestration_script collect "$@"
            ;;
        cleanup)
            shift
            run_orchestration_script cleanup "$@"
            ;;
    esac

    require_orchestrate_cmd
    setup_orchestration_provider_if_needed "$@"
    enter_repo_if_needed
    save_history "Multi-CLI Orchestration"

    case "$subcmd" in
        "")
            exec "$ORCHESTRATE_CMD" --list
            ;;
        review)
            shift
            local -a review_extra_args=()
            local -a review_task_parts=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --cwd|--from-run)
                        local flag_name="$1"
                        review_extra_args+=("$flag_name")
                        shift
                        if [[ $# -eq 0 ]]; then
                            echo -e "${RED}Erro: ${flag_name} requer valor.${RESET}"
                            exit 1
                        fi
                        review_extra_args+=("$1")
                        shift
                        ;;
                    --execute|--auto-approve|--list)
                        review_extra_args+=("$1")
                        shift
                        ;;
                    --task)
                        shift
                        if [[ $# -eq 0 ]]; then
                            echo -e "${RED}Erro: --task requer texto.${RESET}"
                            exit 1
                        fi
                        review_task_parts+=("$1")
                        shift
                        ;;
                    --)
                        shift
                        while [[ $# -gt 0 ]]; do
                            review_task_parts+=("$1")
                            shift
                        done
                        ;;
                    --*)
                        echo -e "${RED}Flag não suportada em ai o review: $1${RESET}"
                        echo "Use: ai o --preset senior-code-review ..."
                        exit 1
                        ;;
                    *)
                        review_task_parts+=("$1")
                        shift
                        ;;
                esac
            done
            local task
            if (( ${#review_task_parts[@]} > 0 )); then
                task="${review_task_parts[*]}"
            else
                task="code review senior do diff atual"
            fi
            exec "$ORCHESTRATE_CMD" --preset senior-code-review "${review_extra_args[@]+"${review_extra_args[@]}"}" --task "$task"
            ;;
        --*)
            exec "$ORCHESTRATE_CMD" "$@"
            ;;
        *)
            exec "$ORCHESTRATE_CMD" --task "$*"
            ;;
    esac
}

orchestration_menu() {
    require_orchestrate_cmd

    enter_repo_if_needed

    echo -e "${BOLD}${CYAN}"
    echo "  ┌──────────────────────────────────────────────────┐"
    echo "  │      🧠 Orquestração Codex + AGY + Claude         │"
    echo "  └──────────────────────────────────────────────────┘"
    echo -e "${RESET}"

    "$ORCHESTRATE_CMD" --list
    echo ""

    local task
    read -rp "Tarefa (enter = apenas listar): " task
    if [[ -z "$task" ]]; then
        return 0
    fi

    local -a presets=()
    local preset_name
    while IFS= read -r preset_name; do
        [[ -n "$preset_name" ]] && presets+=("$preset_name")
    done < <("$ORCHESTRATE_CMD" --list-presets-raw 2>/dev/null || true)
    if (( ${#presets[@]} == 0 )); then
        presets=(adaptive senior-code-review codex-first agy-first claude-first ui-heavy backend-critical migration-critical)
    fi

    echo ""
    echo -e "  ${BOLD}Preset:${RESET}"
    local i
    for i in "${!presets[@]}"; do
        printf "  %d) %s\n" "$((i + 1))" "${presets[$i]}"
    done
    echo ""

    local preset_choice preset
    read -rp "Escolha [1-${#presets[@]}] (default 1): " preset_choice
    preset_choice=$(normalize_choice "$preset_choice")
    preset_choice="${preset_choice:-1}"
    if [[ ! "$preset_choice" =~ ^[0-9]+$ ]] || (( preset_choice < 1 || preset_choice > ${#presets[@]} )); then
        echo -e "${RED}Preset inválido.${RESET}"
        exit 1
    fi
    preset="${presets[$((preset_choice - 1))]}"

    echo ""
    echo -e "  ${BOLD}Modo:${RESET}"
    echo "  1) dry-run (só mostra fluxo)"
    echo "  2) execute gated (roda análise, para antes de escrita)"
    echo "  3) execute auto-approve (permite escrita)"
    echo ""

    local mode_choice
    read -rp "Escolha [1-3] (default 1): " mode_choice
    mode_choice=$(normalize_choice "$mode_choice")

    save_history "Multi-CLI Orchestration [${preset}]"
    case "${mode_choice:-1}" in
        1) exec "$ORCHESTRATE_CMD" --preset "$preset" --task "$task" ;;
        2) exec "$ORCHESTRATE_CMD" --preset "$preset" --execute --task "$task" ;;
        3) exec "$ORCHESTRATE_CMD" --preset "$preset" --execute --auto-approve --task "$task" ;;
        *) echo -e "${RED}Modo inválido.${RESET}"; exit 1 ;;
    esac
}

