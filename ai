# Chat contra ollama.com. Sem prompt = REPL interativo; com prompt = one-shot.
ollama_cloud_chat() {
    local model="$1"; shift
    local key; key=$(ollama_require_key) || return 1
    require_python || return 1

    save_history "Ollama Cloud [${model}]"

    if [[ $# -gt 0 ]]; then
        echo -e "${GREEN}Ollama Cloud:${RESET} ${model} ${DIM}(one-shot)${RESET}"
    else
        echo -e "${GREEN}Ollama Cloud:${RESET} ${model} ${DIM}(/sair para encerrar, /limpar para zerar o contexto)${RESET}"
    fi
    echo ""

    # O script vai para um arquivo temporário em vez de heredoc: com heredoc o
    # stdin do python é o próprio código, e o REPL não conseguiria ler o teclado.
    local pyfile
    pyfile=$(mktemp -t ai-ollama.XXXXXX) || return 1
    trap "rm -f '$pyfile'" RETURN

    cat > "$pyfile" <<'PY'
import json, os, sys, urllib.request, urllib.error

HOST = os.environ["OLLAMA_HOSTV"].rstrip("/")
KEY = os.environ["OLLAMA_KEY"]
MODEL = os.environ["OLLAMA_MODELV"]
DIM, RESET, RED = "\033[2m", "\033[0m", "\033[31m"

def stream(messages):
    body = json.dumps({"model": MODEL, "messages": messages, "stream": True}).encode()
    req = urllib.request.Request(
        HOST + "/api/chat",
        data=body,
        headers={"Authorization": "Bearer " + KEY, "Content-Type": "application/json"},
    )
    parts, thinking_open = [], False
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            for raw in r:
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    chunk = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                if "error" in chunk:
                    print(f"{RED}erro: {chunk['error']}{RESET}", file=sys.stderr)
                    return None
                msg = chunk.get("message") or {}
                think = msg.get("thinking")
                if think:
                    if not thinking_open:
                        sys.stdout.write(DIM)
                        thinking_open = True
                    sys.stdout.write(think)
                    sys.stdout.flush()
                content = msg.get("content")
                if content:
                    if thinking_open:
                        sys.stdout.write(RESET + "\n")
                        thinking_open = False
                    sys.stdout.write(content)
                    sys.stdout.flush()
                    parts.append(content)
                if chunk.get("done"):
                    break
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:300]
        print(f"{RED}erro HTTP {e.code}: {detail}{RESET}", file=sys.stderr)
        return None
    except KeyboardInterrupt:
        print()
        return "".join(parts)
    except Exception as e:
        print(f"{RED}erro: {e}{RESET}", file=sys.stderr)
        return None
    finally:
        if thinking_open:
            sys.stdout.write(RESET)
    print()
    return "".join(parts)

# One-shot: prompt veio na linha de comando
if len(sys.argv) > 1:
    out = stream([{"role": "user", "content": " ".join(sys.argv[1:])}])
    sys.exit(0 if out is not None else 1)

# REPL
history = []
while True:
    try:
        line = input("\033[1m› \033[0m").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nSaindo.")
        break
    if not line:
        continue
    if line in ("/sair", "/exit", "/quit", "/q"):
        print("Saindo.")
        break
    if line in ("/limpar", "/clear", "/reset"):
        history = []
        print(f"{DIM}contexto zerado{RESET}")
        continue
    history.append({"role": "user", "content": line})
    out = stream(history)
    if out is None:
        history.pop()
        continue
    history.append({"role": "assistant", "content": out})
    print()
PY

    # stdin fica livre para o REPL ler o teclado
    OLLAMA_KEY="$key" OLLAMA_HOSTV="$OLLAMA_CLOUD_HOST" OLLAMA_MODELV="$model" \
        python3 "$pyfile" "$@"
}

# Modo local: exige o binário e roda o modelo na máquina
ollama_local_run() {
    local model="${1:-}"; shift || true

    if ! check_installed ollama; then
        echo -e "${RED}Erro: ollama não está instalado (necessário para o modo local).${RESET}"
        echo "  Instale: brew install ollama"
        echo "  Ou:      curl -fsSL https://ollama.com/install.sh | sh"
        return 1
    fi

    if [[ -z "$model" ]]; then
        model="$OLLAMA_LOCAL_MODEL"
    fi
    if [[ -z "$model" ]]; then
        echo -e "${RED}Erro: nenhum modelo local definido.${RESET}"
        echo "  Use:  ai ol local <modelo>"
        echo "  Ou defina o default: AI_OLLAMA_LOCAL_MODEL=<modelo>"
        echo ""
        echo -e "  ${DIM}Modelos já baixados:${RESET}"
        ollama list 2>/dev/null | tail -n +2 | sed 's/^/    /' || true
        return 1
    fi

    save_history "Ollama local [${model}]"
    echo -e "${GREEN}Ollama local:${RESET} ${model}"
    echo ""
    exec ollama run "$model" ${1+"$@"}
}

ollama_status_icon() {
    if [[ -n "$(ollama_api_key)" ]]; then
        echo -e "${GREEN}✔${RESET}"
    else
        echo -e "${YELLOW}✗ sem key${RESET}"
    fi
}

# Dispatcher de 'ai ollama ...'
ollama_dispatch() {
    local sub="${1:-}"
    local model="$OLLAMA_CLOUD_MODEL"

    case "$sub" in
        ls|list|models)
            ollama_cloud_list
            return $?
            ;;
        key|login-key)
            shift || true
            ollama_save_key "${1:-}"
            return $?
            ;;
        login|signin)
            if ! check_installed ollama; then
                echo -e "${RED}Erro: ollama não está instalado.${RESET}"
                echo "  Instale: brew install ollama"
                return 1
            fi
            echo -e "${DIM}Login por browser — habilita o REPL nativo 'ollama run' com modelos cloud.${RESET}"
            exec ollama signin
            ;;
        local)
            shift || true
            ollama_local_run "$@"
            return $?
            ;;
        -m|--model)
            shift || true
            model="${1:-}"
            if [[ -z "$model" ]]; then
                echo -e "${RED}Erro: ai ol -m <modelo>${RESET}"
                return 1
            fi
            shift || true
            ;;
    esac

    ollama_cloud_chat "$model" "$@"
}

