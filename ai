    echo -e "${BOLD}${CYAN}📊 Uso das contas Claude${RESET} ${DIM}(janela 5h / 7 dias)${RESET}"
    echo ""
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(conta_meta_get "$nome" email || true)
        local ckey
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}●${RESET}"
            ckey="claude:__active__"
            out=$(conta_usage_pct "" || true)     # ativa: token do slot, mais fresco
        else
            marker="${DIM}○${RESET}"
            ckey="claude:${nome}"
            out=$(conta_usage_pct "$nome" || true)
        fi
        if [[ "$out" == "RATELIMIT" ]]; then
            # API bloqueou a consulta: mostra o último valor conhecido com idade
            local stale
            if stale=$(_usage_cache_get_stale "$ckey"); then
                local linha="${stale%|*}" idade="${stale##*|}"
                u5=$(echo "$linha" | cut -d' ' -f1)
                u7=$(echo "$linha" | cut -d' ' -f2)
                reset=$(echo "$linha" | cut -d' ' -f3)
                printf "  %b %-14s %-30s ${DIM}5h: %3d%%  7d: %3d%%  reseta %s  (dado de %s min atrás — API limitou consultas)${RESET}\n" \
                    "$marker" "$nome" "${email:-?}" "$u5" "$u7" "$reset" "$idade"
            else
                printf "  %b %-14s %-30s ${DIM}consulta de uso rate-limitada pela API — volta sozinho em alguns minutos${RESET}\n" \
                    "$marker" "$nome" "${email:-?}"
            fi
        elif [[ -n "$out" ]]; then
            u5=$(echo "$out" | cut -d' ' -f1)
            u7=$(echo "$out" | cut -d' ' -f2)
            reset=$(echo "$out" | cut -d' ' -f3)
            cor="$GREEN"
            (( u5 >= 80 )) && cor="$YELLOW"
            (( u5 >= 100 )) && cor="$RED"
            printf "  %b %-14s %-30s 5h: %b%3d%%%b  7d: %3d%%  ${DIM}reseta %s${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$cor" "$u5" "$RESET" "$u7" "$reset"
        else
            printf "  %b %-14s %-30s ${DIM}uso indisponível (sessão expirada? reative: ai conta use %s)${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$nome"
        fi
    done
    (( n == 0 )) && echo -e "  ${DIM}Nenhuma conta salva. Adicione: ${RESET}${BOLD}ai conta add <nome>${RESET}"
    echo ""
}

conta_autoswitch_if_needed() {
    # Antes de lançar o Claude: se a janela de 5h da conta ativa atingiu o
    # threshold, troca para outra conta salva com quota. Fail-open: problema
    # de rede/API nunca bloqueia o launch.
    [[ "$CONTA_AUTO_SWITCH" == "true" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    command -v security >/dev/null 2>&1 || return 0
    local f nomes=()
    for f in "$ACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nomes+=("$(basename "$f" .json)")
    done
    (( ${#nomes[@]} >= 2 )) || return 0

    local out u5
    out=$(conta_usage_pct "" || true)
    if [[ "$out" == "RATELIMIT" ]]; then
        # Consulta bloqueada: usa o último valor conhecido se for recente (≤15min)
        local stale
        if stale=$(_usage_cache_get_stale "claude:__active__") && (( ${stale##*|} <= 15 )); then
            out="${stale%|*}"
        else
            return 0
        fi
    fi
    [[ -z "$out" ]] && return 0
    u5=${out%% *}
    [[ "$u5" =~ ^[0-9]+$ ]] || return 0
    (( u5 >= CONTA_AUTO_THRESHOLD )) || return 0

    local email_ativo nome_ativo
    email_ativo=$(conta_active_email)
    nome_ativo=$(conta_find_by_email "$email_ativo" || true)
    [[ -z "$nome_ativo" ]] && return 0   # ativa não salva: não arrisca trocar

    echo -e "${YELLOW}⚠ Conta '${nome_ativo}' está em ${u5}% da janela de 5h — procurando outra conta...${RESET}"
    local nome alvo="" fallback="" out2 u2
    for nome in "${nomes[@]}"; do
        [[ "$nome" == "$nome_ativo" ]] && continue
        out2=$(conta_usage_pct "$nome" || true)
        if [[ -n "$out2" && "$out2" != "RATELIMIT" && "${out2%% *}" =~ ^[0-9]+$ ]]; then
            u2=${out2%% *}
            if (( u2 < CONTA_AUTO_THRESHOLD )); then
                alvo="$nome"
                echo -e "  ${GREEN}→ '${nome}' está em ${u2}% — trocando.${RESET}"
                break
            fi
        else
            [[ -z "$fallback" ]] && fallback="$nome"
        fi
    done
    if [[ -z "$alvo" && -n "$fallback" ]]; then
        alvo="$fallback"
        echo -e "  ${DIM}→ uso de '${alvo}' não verificável; tentando mesmo assim.${RESET}"
    fi
    if [[ -z "$alvo" ]]; then
        echo -e "  ${RED}Todas as contas salvas estão no limite — seguindo na atual.${RESET}"
        return 0
    fi
    conta_use "$alvo" || true
}

conta_add() {
    # Fluxo guiado: protege a conta ativa, loga na NOVA via 'claude auth login',
    # salva e oferece voltar. Rollback automático se o login falhar.
    local nome="${1:-}"
    _conta_require_deps || return 1
    if ! command -v claude >/dev/null 2>&1; then
        echo -e "${RED}Claude Code CLI não encontrado.${RESET}"
        return 1
    fi
    if [[ ! -t 0 ]]; then
        echo -e "${RED}'ai conta add' precisa de terminal interativo (o login abre o navegador).${RESET}"
        return 1
    fi
    if [[ -z "$nome" ]]; then
        read -rp "$(echo -e "  Nome para a ${BOLD}nova${RESET} conta ${DIM}(ex.: pessoal, trabalho)${RESET}: ")" nome
    fi
    [[ -z "$nome" ]] && { echo -e "${DIM}cancelado${RESET}"; return 1; }
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    if conta_keychain_has "$nome"; then
        echo -e "${RED}Já existe uma conta salva chamada '${nome}'.${RESET} ${DIM}(remova antes: ai conta rm ${nome})${RESET}"
        return 1
    fi

    # 1) Protege a conta ativa antes de deslogar
    local email_antes nome_anterior=""
    email_antes=$(conta_active_email)
    if [[ -n "$email_antes" ]]; then
        if nome_anterior=$(conta_find_by_email "$email_antes"); then
            conta_snapshot_to "$nome_anterior" || return 1
        else
            local salvar_como
            read -rp "$(echo -e "  A conta ativa (${email_antes}) precisa ser salva antes. Nome para ela: ")" salvar_como
            [[ -z "$salvar_como" ]] && { echo -e "${RED}cancelado — nada foi alterado.${RESET}"; return 1; }
            conta_save "$salvar_como" || return 1
            nome_anterior="$salvar_como"
        fi
    fi

    # 2) Login na conta nova (única vez que o navegador é necessário)
    echo ""
    echo -e "  ${BOLD}No navegador que vai abrir, entre com a conta NOVA.${RESET}"
    [[ -n "$nome_anterior" ]] && echo -e "  ${DIM}(a conta '${nome_anterior}' já está protegida no Keychain)${RESET}"
    echo -e "  ${DIM}Dica: se o navegador reabrir já logado na conta antiga, saia dela no site primeiro.${RESET}"
    echo ""
    # NÃO usar 'claude auth logout': ele pode revogar os tokens da conta ativa
    # no servidor, inutilizando o backup recém-salvo. 'login' regrava o slot.
    if ! claude auth login; then
        echo -e "${RED}Login falhou ou foi cancelado.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            echo -e "  Restaurando '${nome_anterior}'..."
            conta_use "$nome_anterior" || true
        fi
        return 1
    fi

    # 3) Valida e salva a conta nova
    local email_depois
    email_depois=$(conta_active_email)
    if [[ -z "$email_depois" ]]; then
        echo -e "${RED}Não foi possível confirmar o login.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            conta_use "$nome_anterior" || true
        fi
        return 1
    fi
    if [[ -n "$email_antes" && "$email_depois" == "$email_antes" ]]; then
        echo -e "${YELLOW}Você entrou na MESMA conta (${email_depois}) — nada novo para salvar.${RESET}"
        conta_snapshot_to "$nome_anterior" >/dev/null 2>&1 || true
        return 1
    fi
    conta_save "$nome" || return 1

    # 4) Ficar na nova ou voltar?
    echo ""
    local ficar
    read -rp "$(echo -e "  ${BOLD}1)${RESET} Continuar na '${nome}'   ${BOLD}2)${RESET} Voltar para '${nome_anterior:-anterior}'   [1]: ")" ficar
    if [[ "$ficar" == "2" && -n "$nome_anterior" ]]; then
        conta_use "$nome_anterior"
    else
        echo -e "${GREEN}✔ Usando '${nome}' (${email_depois}).${RESET}"
    fi
}

conta_menu() {
    _conta_require_deps || return 1
    # Não-interativo: só lista e sai
    if [[ ! -t 0 ]]; then
        conta_list
        return 0
    fi
    local nomes f i escolha novo salvar
    while true; do
        conta_list
        nomes=()
        for f in "$ACCOUNTS_DIR"/*.json; do
            [[ -f "$f" ]] || continue
            nomes+=("$(basename "$f" .json)")
        done
        if (( ${#nomes[@]} == 0 )); then
            read -rp "$(echo -e "  Salvar a conta ativa agora? Nome ${DIM}(vazio = sair)${RESET}: ")" salvar
            [[ -n "$salvar" ]] && { conta_save "$salvar"; continue; }
            echo -e "  ${DIM}Para cadastrar a segunda conta: ${RESET}${BOLD}ai conta add <nome>${RESET}"
            return 0
        fi
        i=1
        echo -e "  ${BOLD}Trocar para:${RESET}"
        for nome in "${nomes[@]}"; do
            printf "  ${BOLD}%d)${RESET} %s\n" "$i" "$nome"
            i=$((i+1))
        done
        echo -e "  ${BOLD}a)${RESET} Adicionar conta nova (login guiado)"
        echo -e "  ${BOLD}u)${RESET} Ver uso das contas (5h/7d)"
        echo -e "  ${BOLD}s)${RESET} Salvar conta ativa com novo nome"
        echo -e "  ${BOLD}x)${RESET} Contas Codex →"
        echo -e "  ${DIM}0) Voltar${RESET}"
        read -rp "Escolha: " escolha
        case "$escolha" in
            0|"") return 0 ;;
            a|A) conta_add; _conta_pausar ;;
            u|U) conta_status; _conta_pausar ;;
            x|X) xconta_menu ;;
            s|S)
                read -rp "  Nome para a conta ativa: " novo
                [[ -n "$novo" ]] && conta_save "$novo"
                _conta_pausar
                ;;
            *)
                if [[ "$escolha" =~ ^[0-9]+$ ]] && (( escolha >= 1 && escolha <= ${#nomes[@]} )); then
                    conta_use "${nomes[$((escolha-1))]}"
                else
                    echo "Opção inválida."
                fi
                _conta_pausar
                ;;
        esac
    done
}

# ── Contas Codex (troca de conta sem logout) ─────────────
# O Codex CLI guarda a sessão ChatGPT em ~/.codex/auth.json (modo arquivo).
# Cada conta salva vira:
#   - Keychain "ai-launcher-xconta:<nome>"  → auth.json completo (criptografado)
#   - ${XACCOUNTS_DIR}/<nome>.json          → email + savedAt (0600)
# Uso/limites via chatgpt.com/backend-api (janelas primária 5h / semanal),
# com refresh automático do token salvo quando ele envelhece.

xconta_active_email() {
    python3 - <<'PY' 2>/dev/null || true
import json, os, base64
try:
    d = json.load(open(os.path.expanduser('~/.codex/auth.json')))
    tok = (d.get('tokens') or {}).get('id_token', '')
    p = tok.split('.')[1]
    p += '=' * ((4 - len(p) % 4) % 4)
    print(json.loads(base64.urlsafe_b64decode(p)).get('email', ''))
except Exception:
    pass
PY
}

xconta_meta_get() {
    local f="${XACCOUNTS_DIR}/$1.json"
    [[ -f "$f" ]] || return 1
    CONTA_META_FILE="$f" CONTA_META_KEY="$2" python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    with open(os.environ['CONTA_META_FILE']) as f:
        print(json.load(f).get(os.environ['CONTA_META_KEY'], ''))
except Exception:
    pass
PY
}

xconta_keychain_has() {
    security find-generic-password -s "${XACCOUNT_KEYCHAIN_PREFIX}:$1" -a "$USER" >/dev/null 2>&1
}

_xconta_write_active() {
    # Escrita atômica do ~/.codex/auth.json com 0600
    local blob="$1" tmp
    mkdir -p "$(dirname "$CODEX_AUTH_FILE")"
    tmp=$(mktemp "${CODEX_AUTH_FILE}.tmp.XXXXXX") || return 1
    printf '%s' "$blob" > "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp"
    mv "$tmp" "$CODEX_AUTH_FILE"
}

_xconta_compact_json() {
    # stdin: JSON (qualquer formatação) → stdout: JSON em 1 linha (ASCII)
    # O Keychain devolve valores com quebra de linha em hex; gravar compacto evita isso.
    python3 -c "import sys, json; print(json.dumps(json.load(sys.stdin), separators=(',', ':')))" 2>/dev/null
}

_xconta_read_backup() {
    # Lê backup do Keychain normalizando saída hex → texto (estilo Symbioose)
    security find-generic-password -s "${XACCOUNT_KEYCHAIN_PREFIX}:$1" -a "$USER" -w 2>/dev/null | python3 -c "
import sys, json, re
raw = sys.stdin.read().strip()
try:
    json.loads(raw)
    sys.stdout.write(raw)
    raise SystemExit(0)
except ValueError:
    pass
compact = ''.join(raw.split())
if compact and len(compact) % 2 == 0 and re.fullmatch(r'[0-9a-fA-F]+', compact):
    try:
        dec = bytes.fromhex(compact).decode('utf-8').strip()
        json.loads(dec)
        sys.stdout.write(dec)
        raise SystemExit(0)
    except Exception:
        pass
raise SystemExit(1)" 2>/dev/null
}

xconta_snapshot_to() {
    # Fotografa a sessão ativa do Codex como backup <nome>
    local nome="$1" blob email
    blob=$(cat "$CODEX_AUTH_FILE" 2>/dev/null) || true
    if [[ -z "$blob" ]]; then
        echo -e "${RED}Nenhuma sessão ativa do Codex (~/.codex/auth.json não existe).${RESET}"
        echo -e "  Faça login primeiro: ${BOLD}codex login${RESET}"
        return 1
    fi
    email=$(xconta_active_email)
    if [[ -z "$email" ]]; then
        echo -e "${RED}Sessão do Codex sem login ChatGPT (modo API key?) — nada para salvar.${RESET}"
        return 1
    fi
    # Compacta para 1 linha: valores multi-linha voltam do Keychain como hex
    local blob_compact
    blob_compact=$(printf '%s' "$blob" | _xconta_compact_json) || true
    [[ -z "$blob_compact" ]] && blob_compact="$blob"
    if ! security add-generic-password -U -s "${XACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w "$blob_compact" 2>/dev/null; then
        echo -e "${RED}Falha ao gravar backup '${nome}' no Keychain.${RESET}"
        return 1
    fi
    mkdir -p "$XACCOUNTS_DIR" && chmod 700 "$XACCOUNTS_DIR"
    CONTA_NOME="$nome" CONTA_DIR="$XACCOUNTS_DIR" CONTA_EMAIL="$email" python3 - <<'PY'
import json, os, datetime
meta = {
    'email': os.environ.get('CONTA_EMAIL', ''),
    'savedAt': datetime.datetime.now().astimezone().isoformat(timespec='seconds'),
}
path = os.path.join(os.environ['CONTA_DIR'], os.environ['CONTA_NOME'] + '.json')
tmp = path + '.tmp'
with open(tmp, 'w') as f:
    json.dump(meta, f, indent=2, ensure_ascii=False)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

xconta_save() {
    local nome="${1:-}"
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai xconta save <nome>${RESET}   ${DIM}ex.: ai xconta save trabalho${RESET}"
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    xconta_snapshot_to "$nome" || return 1
    local email
    email=$(xconta_meta_get "$nome" email || true)
    echo -e "${GREEN}✔ Conta Codex '${nome}' salva${RESET} ${DIM}(${email:-email desconhecido})${RESET}"
}

xconta_find_by_email() {
    local email="$1" f nome
    [[ -n "$email" ]] || return 1
    for f in "$XACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nome=$(basename "$f" .json)
        if [[ "$(xconta_meta_get "$nome" email || true)" == "$email" ]]; then
            echo "$nome"
            return 0
        fi
    done
    return 1
}

xconta_use() {
    local nome="${1:-}" email_ativo nome_ativo email_destino blob
    _conta_require_deps || return 1
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai xconta use <nome>${RESET}"
        xconta_list
        return 1
    fi
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido.${RESET}"
        return 1
    fi
    if ! xconta_keychain_has "$nome"; then
        echo -e "${RED}Conta Codex '${nome}' não encontrada no Keychain.${RESET}"
        xconta_list
        return 1
    fi

    email_ativo=$(xconta_active_email)
    email_destino=$(xconta_meta_get "$nome" email || true)

    # Re-snapshot da sessão ativa (tokens do Codex rotacionam rápido)
    if nome_ativo=$(xconta_find_by_email "$email_ativo"); then
        if ! xconta_snapshot_to "$nome_ativo"; then
            echo -e "${RED}Falha ao atualizar snapshot da conta ativa ('${nome_ativo}'). Troca abortada.${RESET}"
            return 1
        fi
    elif [[ -n "$email_ativo" ]]; then
        echo -e "${YELLOW}A conta Codex ativa (${email_ativo}) não está salva — sem backup ela exigirá novo login depois.${RESET}"
        if [[ -t 0 ]]; then
            local novo_nome
            read -rp "$(echo -e "  Salvar conta ativa como ${DIM}(vazio = não salvar)${RESET}: ")" novo_nome
            if [[ -n "$novo_nome" ]]; then
                xconta_save "$novo_nome" || return 1
            fi
        else
            echo -e "  Salve antes: ${BOLD}ai xconta save <nome>${RESET}"
            return 1
        fi
    fi

    if [[ -n "$email_destino" && "$email_destino" == "$email_ativo" ]]; then
        echo -e "${GREEN}✔ '${nome}' já é a conta Codex ativa${RESET} ${DIM}(${email_ativo}) — snapshot atualizado.${RESET}"
        return 0
    fi

    blob=$(_xconta_read_backup "$nome") || true
    if [[ -z "$blob" ]]; then
        echo -e "${RED}Falha ao ler o backup '${nome}' do Keychain.${RESET}"
        return 1
    fi
    [[ -f "$CODEX_AUTH_FILE" ]] && cp "$CODEX_AUTH_FILE" "${CODEX_AUTH_FILE}.bak-ai-launcher" 2>/dev/null
    if ! _xconta_write_active "$blob"; then
        echo -e "${RED}Falha ao gravar ~/.codex/auth.json.${RESET}"
        return 1
    fi

    echo -e "${GREEN}✔ Conta Codex ativa agora: ${BOLD}${nome}${RESET} ${DIM}(${email_destino:-?})${RESET}"
    echo -e "${DIM}  Sessões codex já abertas continuam na conta anterior — reinicie-as para usar a nova.${RESET}"
}

_xconta_usage_py() {
    # XCONTA_BLOB (env): blob auth.json → stdout: "u5 u7 reset" (+ "REFRESHED <blob>")
    # Usa env var em vez de stdin: o heredoc PY já ocupa o stdin do python.
    python3 - <<'PY'
import os, json, base64, datetime, urllib.request, urllib.parse

USAGE_URLS = (
    'https://chatgpt.com/backend-api/wham/usage',
    'https://chatgpt.com/backend-api/api/codex/usage',
)

def jwt_payload(tok):
    try:
        p = tok.split('.')[1]
        p += '=' * ((4 - len(p) % 4) % 4)
        return json.loads(base64.urlsafe_b64decode(p))
    except Exception:
        return None

def fetch(blob):
    try:
        d = json.loads(blob)
    except Exception:
        return None
    t = d.get('tokens') or {}
    tok = t.get('access_token')
    acc = t.get('account_id')
    if not acc and t.get('id_token'):
        p = jwt_payload(t['id_token']) or {}
        a = p.get('https://api.openai.com/auth', {})
        if isinstance(a, dict):
            acc = a.get('chatgpt_account_id')
    if not tok or not acc:
        return None, 0
    ra429 = 0
    for url in USAGE_URLS:
        req = urllib.request.Request(url)
        req.add_header('Authorization', 'Bearer ' + tok)
        req.add_header('ChatGPT-Account-Id', str(acc))
        req.add_header('Accept', 'application/json')
        req.add_header('User-Agent', 'ai-launcher')
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                return json.load(r), 0
        except urllib.error.HTTPError as e:
            if e.code == 429:
                try:
                    ra429 = max(ra429, int(e.headers.get('Retry-After', '0')))
                except (TypeError, ValueError):
                    ra429 = max(ra429, 60)
            continue
        except Exception:
            continue
    return None, ra429

def refresh(blob):
    try:
        d = json.loads(blob)
    except Exception:
        return None
    t = d.get('tokens') or {}
    rt = t.get('refresh_token')
    if not rt:
        return None
    body = urllib.parse.urlencode({
        'grant_type': 'refresh_token',
        'refresh_token': rt,
        'client_id': 'app_EMoamEEZ73f0CkXaXp7hrann',
    }).encode()
    req = urllib.request.Request('https://auth.openai.com/oauth/token', data=body, method='POST')
    req.add_header('Content-Type', 'application/x-www-form-urlencoded')
    req.add_header('Accept', 'application/json')
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            new = json.load(r)
    except Exception:
        return None
    for k in ('access_token', 'refresh_token', 'id_token'):
        if new.get(k):
            t[k] = new[k]
    if new.get('account_id'):
        t['account_id'] = new['account_id']
    d['tokens'] = t
    d['last_refresh'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'
    return json.dumps(d)

def emit(u):
    rl = (u or {}).get('rate_limit') or {}
    pw = rl.get('primary_window') or {}
    sw = rl.get('secondary_window') or {}
    u1 = pw.get('used_percent')
    if u1 is None:
        return False
    u2 = sw.get('used_percent')
    reset = '?'
    try:
        reset = datetime.datetime.fromtimestamp(pw.get('reset_at')).astimezone().strftime('%H:%M')
    except Exception:
        pass
    print(int(round(u1)), int(round(u2 if u2 is not None else 0)), reset)
    return True

blob = os.environ.get('XCONTA_BLOB', '')
u, ra = fetch(blob)
if u is not None and emit(u):
    raise SystemExit(0)
if ra > 0:
    print('RATELIMIT %d' % max(ra, 60))
    raise SystemExit(3)
nb = refresh(blob)
if nb:
    u, ra = fetch(nb)
    if u is not None and emit(u):
        print('REFRESHED ' + nb)
        raise SystemExit(0)
    if ra > 0:
        print('RATELIMIT %d' % max(ra, 60))
        raise SystemExit(3)
raise SystemExit(1)
PY
}

xconta_usage_pct() {
    # xconta_usage_pct [nome] ("" = sessão ativa) → "u5 u7 reset_local"
    local nome="${1:-}" blob out linha1 refreshed cache_key
    if [[ -n "$nome" ]]; then
        cache_key="codex:${nome}"
    else
        cache_key="codex:__active__"
    fi
    if linha1=$(_usage_cache_get "$cache_key"); then
        printf '%s\n' "$linha1"
        return 0
    fi
    if _usage_cache_get "${cache_key}:rl" >/dev/null 2>&1; then
        printf 'RATELIMIT\n'
        return 0
    fi
    if [[ -n "$nome" ]]; then
        blob=$(_xconta_read_backup "$nome") || true
    else
        blob=$(cat "$CODEX_AUTH_FILE" 2>/dev/null) || true
    fi
    [[ -z "$blob" ]] && return 1
    local rc
    out=$(XCONTA_BLOB="$blob" _xconta_usage_py)
    rc=$?
    if (( rc == 3 )); then
        local ra
        ra=$(printf '%s\n' "$out" | sed -n 's/^RATELIMIT //p')
        [[ "$ra" =~ ^[0-9]+$ ]] || ra=120
        (( ra > 1800 )) && ra=1800
        _usage_cache_put "${cache_key}:rl" "RATELIMIT" "$ra"
        printf 'RATELIMIT\n'
        return 0
    fi
    (( rc != 0 )) && return 1
    linha1=$(printf '%s\n' "$out" | sed -n '1p')
    refreshed=$(printf '%s\n' "$out" | sed -n '2p')
    # Token renovado durante a consulta: regrava para manter a sessão viva
    if [[ "$refreshed" == REFRESHED\ * ]]; then
        local novo_blob="${refreshed#REFRESHED }"
        if [[ -n "$nome" ]]; then
            security add-generic-password -U -s "${XACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" -w "$novo_blob" 2>/dev/null || true
        else
            _xconta_write_active "$novo_blob" 2>/dev/null || true
        fi
    fi
    [[ -z "$linha1" ]] && return 1
    _usage_cache_put "$cache_key" "$linha1"
    printf '%s\n' "$linha1"
}

xconta_status() {
    _conta_require_deps || return 1
    local email_ativo f nome email out u5 u7 reset marker cor n=0
    email_ativo=$(xconta_active_email)
    echo -e "${BOLD}${CYAN}📊 Uso das contas Codex${RESET} ${DIM}(janela 5h / semanal)${RESET}"
    echo ""
    for f in "$XACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(xconta_meta_get "$nome" email || true)
        local ckey
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}●${RESET}"
            ckey="codex:__active__"
            out=$(xconta_usage_pct "" || true)
        else
            marker="${DIM}○${RESET}"
            ckey="codex:${nome}"
            out=$(xconta_usage_pct "$nome" || true)
        fi
        if [[ "$out" == "RATELIMIT" ]]; then
            local stale
            if stale=$(_usage_cache_get_stale "$ckey"); then
                local linha="${stale%|*}" idade="${stale##*|}"
                u5=$(echo "$linha" | cut -d' ' -f1)
                u7=$(echo "$linha" | cut -d' ' -f2)
                reset=$(echo "$linha" | cut -d' ' -f3)
                printf "  %b %-14s %-30s ${DIM}5h: %3d%%  7d: %3d%%  reseta %s  (dado de %s min atrás — API limitou consultas)${RESET}\n" \
                    "$marker" "$nome" "${email:-?}" "$u5" "$u7" "$reset" "$idade"
            else
                printf "  %b %-14s %-30s ${DIM}consulta de uso rate-limitada pela API — volta sozinho em alguns minutos${RESET}\n" \
                    "$marker" "$nome" "${email:-?}"
            fi
        elif [[ -n "$out" ]]; then
            u5=$(echo "$out" | cut -d' ' -f1)
            u7=$(echo "$out" | cut -d' ' -f2)
            reset=$(echo "$out" | cut -d' ' -f3)
            cor="$GREEN"
            (( u5 >= 80 )) && cor="$YELLOW"
            (( u5 >= 100 )) && cor="$RED"
            printf "  %b %-14s %-30s 5h: %b%3d%%%b  7d: %3d%%  ${DIM}reseta %s${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$cor" "$u5" "$RESET" "$u7" "$reset"
        else
            printf "  %b %-14s %-30s ${DIM}uso indisponível (sessão expirada? recadastre: ai xconta add %s)${RESET}\n" \
                "$marker" "$nome" "${email:-?}" "$nome"
        fi
    done
    (( n == 0 )) && echo -e "  ${DIM}Nenhuma conta Codex salva. Adicione: ${RESET}${BOLD}ai xconta add <nome>${RESET}"
    echo ""
}

xconta_autoswitch_if_needed() {
    [[ "$CONTA_AUTO_SWITCH" == "true" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    command -v security >/dev/null 2>&1 || return 0
    local f nomes=()
    for f in "$XACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        nomes+=("$(basename "$f" .json)")
    done
    (( ${#nomes[@]} >= 2 )) || return 0

    local out u5
    out=$(xconta_usage_pct "" || true)
    if [[ "$out" == "RATELIMIT" ]]; then
        local stale
        if stale=$(_usage_cache_get_stale "codex:__active__") && (( ${stale##*|} <= 15 )); then
            out="${stale%|*}"
        else
            return 0
        fi
    fi
    [[ -z "$out" ]] && return 0
    u5=${out%% *}
    [[ "$u5" =~ ^[0-9]+$ ]] || return 0
    (( u5 >= CONTA_AUTO_THRESHOLD )) || return 0

    local email_ativo nome_ativo
    email_ativo=$(xconta_active_email)
    nome_ativo=$(xconta_find_by_email "$email_ativo" || true)
    [[ -z "$nome_ativo" ]] && return 0

    echo -e "${YELLOW}⚠ Conta Codex '${nome_ativo}' está em ${u5}% da janela de 5h — procurando outra conta...${RESET}"
    local nome alvo="" fallback="" out2 u2
    for nome in "${nomes[@]}"; do
        [[ "$nome" == "$nome_ativo" ]] && continue
        out2=$(xconta_usage_pct "$nome" || true)
        if [[ -n "$out2" && "${out2%% *}" =~ ^[0-9]+$ ]]; then
            u2=${out2%% *}
            if (( u2 < CONTA_AUTO_THRESHOLD )); then
                alvo="$nome"
                echo -e "  ${GREEN}→ '${nome}' está em ${u2}% — trocando.${RESET}"
                break
            fi
        else
            [[ -z "$fallback" ]] && fallback="$nome"
        fi
    done
    if [[ -z "$alvo" && -n "$fallback" ]]; then
        alvo="$fallback"
        echo -e "  ${DIM}→ uso de '${alvo}' não verificável; tentando mesmo assim.${RESET}"
    fi
    if [[ -z "$alvo" ]]; then
        echo -e "  ${RED}Todas as contas Codex salvas estão no limite — seguindo na atual.${RESET}"
        return 0
    fi
    xconta_use "$alvo" || true
}

xconta_add() {
    # Fluxo guiado: protege a sessão ativa, loga na NOVA via 'codex login',
    # salva e oferece voltar. Rollback automático se o login falhar.
    local nome="${1:-}"
    _conta_require_deps || return 1
    if ! command -v codex >/dev/null 2>&1; then
        echo -e "${RED}Codex CLI não encontrado.${RESET}"
        return 1
    fi
    if [[ ! -t 0 ]]; then
        echo -e "${RED}'ai xconta add' precisa de terminal interativo (o login abre o navegador).${RESET}"
        return 1
    fi
    if [[ -z "$nome" ]]; then
        read -rp "$(echo -e "  Nome para a ${BOLD}nova${RESET} conta Codex ${DIM}(ex.: pessoal, trabalho)${RESET}: ")" nome
    fi
    [[ -z "$nome" ]] && { echo -e "${DIM}cancelado${RESET}"; return 1; }
    if ! _validate_account_name "$nome"; then
        echo -e "${RED}Nome inválido: use letras minúsculas, números, '-' e '_'.${RESET}"
        return 1
    fi
    if xconta_keychain_has "$nome"; then
        echo -e "${RED}Já existe uma conta Codex salva chamada '${nome}'.${RESET} ${DIM}(remova antes: ai xconta rm ${nome})${RESET}"
        return 1
    fi

    local email_antes nome_anterior=""
    email_antes=$(xconta_active_email)
    if [[ -n "$email_antes" ]]; then
        if nome_anterior=$(xconta_find_by_email "$email_antes"); then
            xconta_snapshot_to "$nome_anterior" || return 1
        else
            local salvar_como
            read -rp "$(echo -e "  A conta Codex ativa (${email_antes}) precisa ser salva antes. Nome para ela: ")" salvar_como
            [[ -z "$salvar_como" ]] && { echo -e "${RED}cancelado — nada foi alterado.${RESET}"; return 1; }
            xconta_save "$salvar_como" || return 1
            nome_anterior="$salvar_como"
        fi
    fi

    echo ""
    echo -e "  ${BOLD}No navegador que vai abrir, entre com a conta NOVA do ChatGPT.${RESET}"
    [[ -n "$nome_anterior" ]] && echo -e "  ${DIM}(a conta '${nome_anterior}' já está protegida no Keychain)${RESET}"
    echo -e "  ${DIM}Dica: se reabrir já logado na conta antiga, saia dela em chatgpt.com primeiro.${RESET}"
    echo ""
    # 'codex login' sobrescreve ~/.codex/auth.json; evitamos 'codex logout'
    # para não invalidar a sessão da conta ativa antes do backup.
    if ! codex login; then
        echo -e "${RED}Login falhou ou foi cancelado.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            echo -e "  Restaurando '${nome_anterior}'..."
            xconta_use "$nome_anterior" || true
        fi
        return 1
    fi

    local email_depois
    email_depois=$(xconta_active_email)
    if [[ -z "$email_depois" ]]; then
        echo -e "${RED}Não foi possível confirmar o login.${RESET}"
        if [[ -n "$nome_anterior" ]]; then
            xconta_use "$nome_anterior" || true
        fi
        return 1
    fi
    if [[ -n "$email_antes" && "$email_depois" == "$email_antes" ]]; then
        echo -e "${YELLOW}Você entrou na MESMA conta (${email_depois}) — nada novo para salvar.${RESET}"
        xconta_snapshot_to "$nome_anterior" >/dev/null 2>&1 || true
        return 1
    fi
    xconta_save "$nome" || return 1

    echo ""
    local ficar
    read -rp "$(echo -e "  ${BOLD}1)${RESET} Continuar na '${nome}'   ${BOLD}2)${RESET} Voltar para '${nome_anterior:-anterior}'   [1]: ")" ficar
    if [[ "$ficar" == "2" && -n "$nome_anterior" ]]; then
        xconta_use "$nome_anterior"
    else
        echo -e "${GREEN}✔ Usando conta Codex '${nome}' (${email_depois}).${RESET}"
    fi
}

xconta_list() {
    _conta_require_deps || return 1
    local email_ativo f nome email saved marker kc n=0
    email_ativo=$(xconta_active_email)
    echo -e "${BOLD}${CYAN}👤 Contas Codex salvas${RESET}"
    echo ""
    for f in "$XACCOUNTS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        n=$((n+1))
        nome=$(basename "$f" .json)
        email=$(xconta_meta_get "$nome" email || true)
        saved=$(xconta_meta_get "$nome" savedAt || true)
        if xconta_keychain_has "$nome"; then
            kc="${GREEN}✔${RESET}"
        else
            kc="${RED}✗ sem credencial${RESET}"
        fi
        if [[ -n "$email" && "$email" == "$email_ativo" ]]; then
            marker="${GREEN}● ativa${RESET}"
        else
            marker="${DIM}○      ${RESET}"
        fi
        printf "  %b %-14s %-34s %b ${DIM}salva: %s${RESET}\n" "$marker" "$nome" "${email:-?}" "$kc" "${saved%%T*}"
    done
    if (( n == 0 )); then
        echo -e "  ${DIM}Nenhuma conta Codex salva ainda.${RESET}"
        echo -e "  Salve a atual: ${BOLD}ai xconta save <nome>${RESET}"
    fi
    if [[ -n "$email_ativo" ]] && ! xconta_find_by_email "$email_ativo" >/dev/null; then
        echo ""
        echo -e "  ${YELLOW}Conta Codex ativa (${email_ativo}) ainda não está salva.${RESET}"
    fi
    echo ""
}

xconta_rm() {
    local nome="${1:-}"
    if [[ -z "$nome" ]]; then
        echo -e "${RED}Uso: ai xconta rm <nome>${RESET}"
        return 1
    fi
    _validate_account_name "$nome" || { echo -e "${RED}Nome inválido.${RESET}"; return 1; }
    local achou=false
    if xconta_keychain_has "$nome"; then
        security delete-generic-password -s "${XACCOUNT_KEYCHAIN_PREFIX}:${nome}" -a "$USER" >/dev/null 2>&1 && achou=true
    fi
    if [[ -f "${XACCOUNTS_DIR}/${nome}.json" ]]; then
        rm -f "${XACCOUNTS_DIR}/${nome}.json" && achou=true
    fi
    if [[ "$achou" == true ]]; then
        echo -e "${GREEN}✔ Backup Codex '${nome}' removido${RESET} ${DIM}(a conta ativa não é afetada)${RESET}"
    else
        echo -e "${YELLOW}Conta Codex '${nome}' não encontrada.${RESET}"
    fi
}

xconta_menu() {
    _conta_require_deps || return 1
    if [[ ! -t 0 ]]; then
        xconta_list
        return 0
    fi
    local nomes f i escolha nome novo salvar
    while true; do
        xconta_list
        nomes=()
        for f in "$XACCOUNTS_DIR"/*.json; do
            [[ -f "$f" ]] || continue
            nomes+=("$(basename "$f" .json)")
        done
        if (( ${#nomes[@]} == 0 )); then
            read -rp "$(echo -e "  Salvar a conta Codex ativa agora? Nome ${DIM}(vazio = sair)${RESET}: ")" salvar
            [[ -n "$salvar" ]] && { xconta_save "$salvar"; continue; }
            echo -e "  ${DIM}Para cadastrar a segunda conta: ${RESET}${BOLD}ai xconta add <nome>${RESET}"
            return 0
        fi
        i=1
        echo -e "  ${BOLD}Trocar para:${RESET}"
        for nome in "${nomes[@]}"; do
            printf "  ${BOLD}%d)${RESET} %s\n" "$i" "$nome"
            i=$((i+1))
        done
        echo -e "  ${BOLD}a)${RESET} Adicionar conta Codex nova (login guiado)"
        echo -e "  ${BOLD}u)${RESET} Ver uso das contas (5h/semanal)"
        echo -e "  ${BOLD}s)${RESET} Salvar conta ativa com novo nome"
        echo -e "  ${DIM}0) Voltar${RESET}"
        read -rp "Escolha: " escolha
        case "$escolha" in
            0|"") return 0 ;;
            a|A) xconta_add; _conta_pausar ;;
            u|U) xconta_status; _conta_pausar ;;
            s|S)
                read -rp "  Nome para a conta ativa: " novo
                [[ -n "$novo" ]] && xconta_save "$novo"
                _conta_pausar
                ;;
            *)
                if [[ "$escolha" =~ ^[0-9]+$ ]] && (( escolha >= 1 && escolha <= ${#nomes[@]} )); then
                    xconta_use "${nomes[$((escolha-1))]}"
                else
                    echo "Opção inválida."
                fi
                _conta_pausar
                ;;
        esac
    done
}

