# Endpoint: Singapura (intl) por padrão; Pequim ou US via AI_QWEN_BASE_URL.
# Modelo: qwen3-max-latest (alias que segue o Max mais novo). Fixe a versão
# exata com AI_QWEN_MODEL=qwen3.8-max quando quiser travar.
QWEN_BASE_URL="${AI_QWEN_BASE_URL:-https://dashscope-intl.aliyuncs.com/compatible-mode/v1}"
