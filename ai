# Lança o Codex usando o endpoint HF como model_provider.
# O provider é injetado via overrides -c (efêmeros): a URL NUNCA é gravada
# no ~/.codex/config.toml. O token vai por env (HF_TOKEN), lido pelo Codex.
hf_launch_codex() {
    if ! check_installed codex; then
        echo -e "${RED}Erro: codex não está instalado.${RESET}"
        echo "  Instale: npm install -g @openai/codex"
        return 1
    fi
    local tok; tok=$(hf_require_token) || return 1
    local url; url=$(hf_endpoint_url)
    if [[ -z "$url" ]]; then
        echo -e "${RED}Erro: nenhum HF Endpoint configurado.${RESET}" >&2
        echo "  Configure: ai hf endpoint <url>" >&2
        return 1
    fi

    save_history "Codex + HF [${HF_ENDPOINT_MODEL##*/}]"
    echo -e "${GREEN}Codex${RESET} usando ${BOLD}${HF_ENDPOINT_MODEL##*/}${RESET} ${DIM}(endpoint dedicado)${RESET}"
    echo -e "${DIM}scale-to-zero: a 1ª chamada pode acordar a GPU (~1-2 min)${RESET}"
    echo ""

    # wire_api="responses": o Codex atual só fala a Responses API da OpenAI;
    # o vLLM do endpoint expõe /v1/responses, então conversa direto.
    export HF_TOKEN="$tok"
    enter_repo_if_needed
    exec codex "${CODEX_FLAGS[@]}" \
        -c model_providers.hf.name='"HF Endpoint"' \
        -c model_providers.hf.base_url="\"${url}/v1\"" \
        -c model_providers.hf.env_key='"HF_TOKEN"' \
        -c model_providers.hf.wire_api='"responses"' \
        -c model_provider='"hf"' \
        -c model="\"${HF_ENDPOINT_MODEL}\"" \
        "$@"
}

# Painel de uso do modelo dedicado (mostrado no menu interativo)
hf_menu_panel() {
    local short="${HF_ENDPOINT_MODEL##*/}"
    local url; url=$(hf_endpoint_url)
    echo -e "${BOLD}${CYAN}"
    echo "  ┌──────────────────────────────────────────────────┐"
    echo "  │   🔒 Modelo dedicado (uncensored) — HF Endpoint  │"
    echo "  └──────────────────────────────────────────────────┘"
    echo -e "${RESET}"
    echo -e "  ${BOLD}Modelo:${RESET}  ${short}"
    echo -e "  ${BOLD}Servidor:${RESET} ${DIM}${url:-<não configurado>}${RESET}"
    echo -e "  ${BOLD}Status:${RESET}  $(hf_status_icon)"
    echo ""
    echo -e "  ${BOLD}Como usar:${RESET}"
    echo -e "    ${GREEN}ai hf${RESET}                    chat interativo (REPL)"
    echo -e "    ${GREEN}ai hf${RESET} \"sua pergunta\"     resposta única (one-shot)"
    echo -e "    ${GREEN}ai hf codex${RESET}              abre o Codex usando este modelo"
    echo -e "    ${GREEN}ai hf status${RESET}             estado do endpoint / réplicas"
    echo -e "    ${GREEN}ai hf key${RESET}                salva o token (1x por Mac)"
    echo -e "    ${GREEN}ai hf endpoint${RESET} <url>     salva a URL do endpoint (1x por Mac)"
    echo ""
    echo -e "  ${DIM}No REPL: /limpar zera o contexto · /sair encerra${RESET}"
    echo -e "  ${DIM}scale-to-zero: dorme ocioso; a 1ª chamada acorda a GPU (~1-2 min)${RESET}"
    echo -e "  ${DIM}Em outro Mac: rode 'ai hf endpoint <url>' e 'ai hf key'${RESET}"
    echo ""
    if [[ -z "$url" ]]; then
        echo -e "  ${YELLOW}Endpoint ainda não configurado nesta máquina.${RESET}"
        echo -e "  ${BOLD}1)${RESET} Configurar endpoint agora    ${BOLD}2)${RESET} Voltar"
        local opt0
        read -rp "  Escolha [1-2] (default 1): " opt0
        opt0=$(normalize_choice "$opt0")
        case "${opt0:-1}" in
            1) hf_save_endpoint_url ;;
            *) return 0 ;;
        esac
        return 0
    fi
    echo -e "  ${BOLD}1)${RESET} Chat / RE    ${BOLD}2)${RESET} Status    ${BOLD}3)${RESET} Abrir no Codex    ${BOLD}4)${RESET} Voltar"
    echo -e "  ${DIM}Codex exige modelo com contexto grande; o modelo atual (70B) só cabe${RESET}"
    echo -e "  ${DIM}em 1 GPU (32K) — use o Chat pra RE. Ver 'ai hf' no --help.${RESET}"
    local opt
    read -rp "  Escolha [1-4] (default 1): " opt
    opt=$(normalize_choice "$opt")
    case "${opt:-1}" in
        1) hf_endpoint_chat ;;
        2) hf_endpoint_status ;;
        3) hf_launch_codex ;;
        *) return 0 ;;
    esac
}

hf_dispatch() {
    local sub="${1:-}"
    case "$sub" in
        key|token)          shift || true; hf_save_key "${1:-}"; return $? ;;
        endpoint|url)       shift || true; hf_save_endpoint_url "${1:-}"; return $? ;;
        codex|x)            shift || true; hf_launch_codex "$@"; return $? ;;
        status|st)          hf_endpoint_status; return $? ;;
        help|-h|--help|menu) hf_menu_panel; return $? ;;
        *)                  hf_endpoint_chat "$@"; return $? ;;
    esac
}

