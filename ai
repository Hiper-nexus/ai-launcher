# Resolve aliases accepted by the launcher to the documented versioned Sakana
# model IDs. The dated Ultra V1.0 name remains a compatibility alias.
sakana_resolve_fugu_model() {
    case "${1:-fugu}" in
        sakana|fugu)
            printf '%s\n' "fugu"
            ;;
        fugu-ultra|sakana-ultra)
            printf '%s\n' "fugu-ultra-v1.1"
            ;;
        fugu-ultra-v1.0|fugu-ultra-20260615|sakana-ultra-v1.0)
            printf '%s\n' "fugu-ultra-v1.0"
            ;;
        fugu-ultra-v1.1|sakana-ultra-v1.1)
            printf '%s\n' "fugu-ultra-v1.1"
            ;;
        *)
            return 1
            ;;
    esac
}

