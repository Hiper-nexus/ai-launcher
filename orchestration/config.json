{
  "default_preset": "adaptive",
  "synthesizer_default": "claude",
  "synthesizer_overrides": {
    "senior-code-review": "codex",
    "review-council": "codex"
  },
  "implementer": "codex",
  "review_only_presets": ["senior-code-review", "review-council"],
  "review_mode": "council-parallel",
  "review_agents_default": ["codex", "glm", "fugu", "claude", "agy"],
  "timeout_seconds": 600,
  "synth_timeout_seconds": 600,
  "retries": 1,
  "backoff_seconds": 6,
  "codex_reasoning_effort": "medium",
  "context_chars": 12000,
  "keep_runs": 20,
  "agents": {
    "codex":  { "cmd": "codex",  "engine": "openai-codex",      "role": "implementer/finalizer/synth", "prompt": "stdin",        "output": "last-message" },
    "fugu":   { "cmd": "codex",  "engine": "sakana-fugu",       "role": "independent reviewer",        "profile": "fugu",        "model": "fugu-ultra", "reasoning_effort": "high", "output": "last-message" },
    "glm":    { "cmd": "claude", "engine": "glm-zai",           "role": "independent reviewer",        "base_url": "https://api.z.ai/api/anthropic", "model": "glm-5.2[1m]" },
    "claude": { "cmd": "claude", "engine": "anthropic",         "role": "architecture/security/risk",  "prompt": "stdin",        "native_login": true },
    "agy":    { "cmd": "agy",    "engine": "google-antigravity","role": "scout/decomposer/reviewer",   "runner": "pty" },
    "gemini": { "cmd": "gemini", "engine": "google-gemini",     "role": "reviewer (opt-in)",           "status": "free-tier-discontinued", "auto_skip": true }
  }
}
